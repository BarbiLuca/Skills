+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP access to the rates API; holds no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout_seconds: float) -> None:
+        self._base_url = base_url
+        self._api_key = api_key
+        self._timeout_seconds = timeout_seconds
+
+    def get_latest(self, base: str, symbol: str) -> Dict[str, Any]:
+        """Call `GET /latest` for one currency pair.
+
+        @param base: base currency code, e.g. "EUR".
+        @param symbol: quote currency code, e.g. "USD".
+        @return: the decoded JSON body, e.g. {"base": "EUR", "rates": {"USD": 1.08}}.
+        @throws RatesApiError: on network failure, a non-2xx status, or a body that is not a JSON object.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": symbol})
+        request = urllib.request.Request(
+            f"{self._base_url}?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, TimeoutError) as error:
+            raise RatesApiError(f"rates API is unreachable: {error}") from error
+
+        try:
+            payload = json.loads(body)
+        except ValueError as error:
+            raise RatesApiError("rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("rates API returned JSON that is not an object")
+        return payload
