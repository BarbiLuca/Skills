+import logging
+import math
+import re
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+
+CURRENCY_CODE_PATTERN = re.compile(r"^[A-Z]{3}$")
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class Rate:
+    base: str
+    quote: str
+    rate: float
+    fetched_at: str
+
+
+class RateService:
+    """Fetches the current rate for a currency pair and stores it."""
+
+    def __init__(
+        self,
+        client: RatesClient,
+        database: Database,
+        clock: Callable[[], datetime] = lambda: datetime.now(timezone.utc),
+    ) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_and_store(self, base: str, quote: str) -> Rate:
+        """Download the current base/quote rate and save it in the `rates` table.
+
+        @param base: base currency code (case-insensitive), e.g. "EUR".
+        @param quote: quote currency code (case-insensitive), e.g. "USD".
+        @return: the stored rate.
+        @throws ValueError: if a currency code is not three letters.
+        @throws RatesApiError: if the API fails or its response lacks a valid rate for the pair.
+        """
+        base = self._normalize_code(base)
+        quote = self._normalize_code(quote)
+
+        payload = self._client.get_latest(base, quote)
+        rate_value = self._extract_rate(payload, base, quote)
+
+        rate = Rate(base=base, quote=quote, rate=rate_value, fetched_at=self._clock().isoformat())
+        self._database.insert_rate(rate.base, rate.quote, rate.rate, rate.fetched_at)
+        logger.info(
+            "rate stored",
+            extra={"action": "rate_stored", "base": base, "quote": quote, "rate": rate_value},
+        )
+        return rate
+
+    @staticmethod
+    def _normalize_code(code: str) -> str:
+        normalized = code.strip().upper()
+        if not CURRENCY_CODE_PATTERN.match(normalized):
+            raise ValueError(f"invalid currency code {code!r}: expected three letters, e.g. EUR")
+        return normalized
+
+    @staticmethod
+    def _extract_rate(payload: dict, base: str, quote: str) -> float:
+        # A mismatched base would silently store the wrong pair, so reject it.
+        if payload.get("base") != base:
+            raise RatesApiError(f"rates API answered for base {payload.get('base')!r}, expected {base!r}")
+        rates = payload.get("rates")
+        if not isinstance(rates, dict) or quote not in rates:
+            raise RatesApiError(f"rates API response has no rate for {quote}")
+        value = rates[quote]
+        # bool is a subclass of int, so exclude it explicitly.
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
+            raise RatesApiError(f"rates API returned an invalid rate for {quote}: {value!r}")
+        return float(value)
