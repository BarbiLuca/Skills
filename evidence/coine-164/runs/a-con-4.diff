+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+DEFAULT_RATES_API_URL = "https://rates.example.com/v1/latest"
+DEFAULT_RATES_API_TIMEOUT_SECONDS = 10.0
+
+
+class ConfigError(Exception):
+    """Raised when a required setting is missing or malformed."""
+
+
+@dataclass(frozen=True)
+class AppConfig:
+    """Settings read from the environment, with `.env` as a fallback source."""
+
+    rates_api_url: str
+    rates_api_key: str
+    rates_api_timeout_seconds: float
+
+    @classmethod
+    def load(cls, env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> "AppConfig":
+        """Build the config from `.env` values overridden by real environment variables.
+
+        @param env_path: path of the `.env` file; a missing file is allowed.
+        @param environ: variables that take precedence over `.env`; defaults to `os.environ`.
+        @return: the validated configuration.
+        @throws ConfigError: if the API key is missing or the timeout is not a positive number.
+        """
+        values = {**cls._read_env_file(env_path), **(os.environ if environ is None else environ)}
+
+        api_key = values.get("RATES_API_KEY", "").strip()
+        if not api_key:
+            raise ConfigError("RATES_API_KEY is not set; add it to .env or the environment")
+
+        raw_timeout = values.get("RATES_API_TIMEOUT_SECONDS", str(DEFAULT_RATES_API_TIMEOUT_SECONDS))
+        try:
+            timeout = float(raw_timeout)
+        except ValueError as error:
+            raise ConfigError(f"RATES_API_TIMEOUT_SECONDS must be a number, got {raw_timeout!r}") from error
+        if timeout <= 0:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be greater than zero")
+
+        return cls(
+            rates_api_url=values.get("RATES_API_URL", DEFAULT_RATES_API_URL).strip(),
+            rates_api_key=api_key,
+            rates_api_timeout_seconds=timeout,
+        )
+
+    @staticmethod
+    def _read_env_file(env_path: Path) -> Dict[str, str]:
+        # Minimal KEY=VALUE parser so the project stays free of third-party dependencies.
+        if not env_path.is_file():
+            return {}
+        values: Dict[str, str] = {}
+        for line in env_path.read_text(encoding="utf-8").splitlines():
+            line = line.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            values[key.strip()] = value.strip().strip("\"'")
+        return values
