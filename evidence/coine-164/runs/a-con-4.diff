+import io
+import json
+import logging
+import tempfile
+import unittest
+import urllib.error
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+from app.__main__ import fetch
+from app.config import AppConfig, ConfigError
+from app.db import Database
+from app.logging_setup import ContextFilter, JsonFormatter
+from app.rates_client import RatesApiError, RatesClient
+from app.rates_service import RateService
+
+FIXED_NOW = datetime(2026, 10, 16, 12, 0, tzinfo=timezone.utc)
+
+
+class RatesClientTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.client = RatesClient("https://rates.example.com/v1/latest", "secret-key", 5.0)
+
+    def test_get_latest_sends_query_and_api_key_header(self) -> None:
+        response = mock.MagicMock()
+        response.__enter__.return_value.read.return_value = b'{"base": "EUR", "rates": {"USD": 1.08}}'
+        with mock.patch("urllib.request.urlopen", return_value=response) as urlopen:
+            payload = self.client.get_latest("EUR", "USD")
+
+        request = urlopen.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret-key")
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5.0)
+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+
+    def test_get_latest_raises_api_error_on_http_error(self) -> None:
+        error = urllib.error.HTTPError("url", 401, "Unauthorized", {}, io.BytesIO(b""))
+        with mock.patch("urllib.request.urlopen", side_effect=error):
+            with self.assertRaisesRegex(RatesApiError, "HTTP 401"):
+                self.client.get_latest("EUR", "USD")
+
+    def test_get_latest_raises_api_error_when_unreachable(self) -> None:
+        with mock.patch("urllib.request.urlopen", side_effect=urllib.error.URLError("no network")):
+            with self.assertRaisesRegex(RatesApiError, "unreachable"):
+                self.client.get_latest("EUR", "USD")
+
+    def test_get_latest_raises_api_error_on_invalid_json(self) -> None:
+        response = mock.MagicMock()
+        response.__enter__.return_value.read.return_value = b"<html>"
+        with mock.patch("urllib.request.urlopen", return_value=response):
+            with self.assertRaisesRegex(RatesApiError, "invalid JSON"):
+                self.client.get_latest("EUR", "USD")
+
+
+class RateServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.database = Database(Path(self.directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        self.service = RateService(self.client, self.database, clock=lambda: FIXED_NOW)
+
+    def test_fetch_and_store_saves_rate_in_database(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+
+        rate = self.service.fetch_and_store("eur", "usd")
+
+        self.client.get_latest.assert_called_once_with("EUR", "USD")
+        self.assertEqual(rate.rate, 1.08)
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": FIXED_NOW.isoformat()}],
+        )
+
+    def test_fetch_and_store_rejects_invalid_currency_code(self) -> None:
+        for code in ["EU", "EURO", "E1R", "'; DROP TABLE rates; --"]:
+            with self.subTest(code=code), self.assertRaises(ValueError):
+                self.service.fetch_and_store(code, "USD")
+        self.client.get_latest.assert_not_called()
+
+    def test_fetch_and_store_rejects_unusable_response(self) -> None:
+        payloads = [
+            {"base": "GBP", "rates": {"USD": 1.08}},
+            {"base": "EUR", "rates": {}},
+            {"base": "EUR"},
+            {"base": "EUR", "rates": {"USD": "1.08"}},
+            {"base": "EUR", "rates": {"USD": -1}},
+            {"base": "EUR", "rates": {"USD": True}},
+        ]
+        for payload in payloads:
+            with self.subTest(payload=payload):
+                self.client.get_latest.return_value = payload
+                with self.assertRaises(RatesApiError):
+                    self.service.fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+class AppConfigTest(unittest.TestCase):
+    def test_load_reads_env_file_and_environment_overrides_it(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_path = Path(directory) / ".env"
+            env_path.write_text('RATES_API_KEY="from-file"\nRATES_API_URL=https://file.example/latest\n')
+
+            config = AppConfig.load(env_path, environ={"RATES_API_KEY": "from-env"})
+
+        self.assertEqual(config.rates_api_key, "from-env")
+        self.assertEqual(config.rates_api_url, "https://file.example/latest")
+
+    def test_load_raises_config_error_without_api_key(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "RATES_API_KEY"):
+            AppConfig.load(Path("/nonexistent/.env"), environ={})
+
+    def test_load_raises_config_error_on_bad_timeout(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "TIMEOUT"):
+            AppConfig.load(Path("/nonexistent/.env"), environ={"RATES_API_KEY": "k", "RATES_API_TIMEOUT_SECONDS": "x"})
+
+
+class FetchCommandTest(unittest.TestCase):
+    def test_fetch_returns_error_code_without_exposing_api_details(self) -> None:
+        config = AppConfig("https://rates.example.com/v1/latest", "k", 5.0)
+        with mock.patch.object(AppConfig, "load", return_value=config), mock.patch(
+            "urllib.request.urlopen", side_effect=urllib.error.URLError("internal host 10.0.0.5")
+        ), mock.patch("sys.stderr", new_callable=io.StringIO) as stderr, self.assertLogs("app", "ERROR"):
+            exit_code = fetch(mock.create_autospec(Database, instance=True), "EUR", "USD")
+
+        self.assertEqual(exit_code, 1)
+        self.assertNotIn("10.0.0.5", stderr.getvalue())
+
+    def test_fetch_returns_usage_error_when_api_key_missing(self) -> None:
+        with mock.patch.object(AppConfig, "load", side_effect=ConfigError("RATES_API_KEY is not set")), mock.patch(
+            "sys.stderr", new_callable=io.StringIO
+        ) as stderr:
+            exit_code = fetch(mock.create_autospec(Database, instance=True), "EUR", "USD")
+
+        self.assertEqual(exit_code, 2)
+        self.assertIn("RATES_API_KEY", stderr.getvalue())
+
+
+class LoggingTest(unittest.TestCase):
+    def test_json_formatter_includes_context_fields(self) -> None:
+        record = logging.makeLogRecord({"msg": "rate stored", "levelname": "INFO", "action": "rate_stored"})
+        ContextFilter().filter(record)
+        entry = json.loads(JsonFormatter().format(record))
+
+        self.assertEqual(entry["action"], "rate_stored")
+        self.assertIn("request_id", entry)
+        self.assertIn("user_id", entry)
+        self.assertIn("timestamp", entry)
+
+
+if __name__ == "__main__":
+    unittest.main()
