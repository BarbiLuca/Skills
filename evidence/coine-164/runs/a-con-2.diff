+import getpass
+import json
+import logging
+import uuid
+from datetime import datetime, timezone
+
+# Attributes every LogRecord has; anything else was passed through `extra=` and is context.
+_STANDARD_ATTRIBUTES = set(vars(logging.makeLogRecord({}))) | {"message", "asctime"}
+
+
+class JsonFormatter(logging.Formatter):
+    """Formats each record as one JSON line with timestamp, level, user, request id, and context."""
+
+    def __init__(self, user_id: str, request_id: str) -> None:
+        super().__init__()
+        self._user_id = user_id
+        self._request_id = request_id
+
+    def format(self, record: logging.LogRecord) -> str:
+        entry = {
+            "timestamp": datetime.fromtimestamp(record.created, timezone.utc).isoformat(),
+            "level": record.levelname,
+            "logger": record.name,
+            "event": record.getMessage(),
+            "user_id": self._user_id,
+            "request_id": self._request_id,
+        }
+        entry.update({key: value for key, value in vars(record).items() if key not in _STANDARD_ATTRIBUTES})
+        if record.exc_info:
+            entry["stack_trace"] = self.formatException(record.exc_info)
+        return json.dumps(entry, default=str)
+
+
+class LoggingSetup:
+    """Configures root logging for one CLI invocation."""
+
+    @staticmethod
+    def configure(level: int = logging.INFO) -> str:
+        """
+        Send JSON logs to stderr, tagged with the OS user and a fresh request id.
+
+        @param level Minimum level to emit.
+        @return The request id assigned to this invocation.
+        @throws KeyError If the OS user cannot be determined.
+        """
+        request_id = uuid.uuid4().hex
+        handler = logging.StreamHandler()
+        handler.setFormatter(JsonFormatter(user_id=getpass.getuser(), request_id=request_id))
+        root = logging.getLogger()
+        root.handlers = [handler]
+        root.setLevel(level)
+        return request_id
