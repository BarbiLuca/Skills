+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import Config, ConfigError
+
+VALID = {
+    "RATES_API_URL": "https://rates.example.com/v1/",
+    "RATES_API_KEY": "secret",
+    "RATES_API_TIMEOUT_SECONDS": "10",
+}
+
+
+class ConfigTest(unittest.TestCase):
+    def test_load_reads_env_file_and_environment_overrides_it(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_path = Path(directory) / ".env"
+            env_path.write_text(
+                "# comment\nRATES_API_URL=https://rates.example.com/v1\nRATES_API_KEY=\"from-file\"\n",
+                encoding="utf-8",
+            )
+            config = Config.load(env_path, environ={"RATES_API_KEY": "from-env", "RATES_API_TIMEOUT_SECONDS": "3"})
+
+        settings = config.rates_api()
+        self.assertEqual(settings.base_url, "https://rates.example.com/v1")
+        self.assertEqual(settings.api_key, "from-env")
+        self.assertEqual(settings.timeout_seconds, 3.0)
+
+    def test_rates_api_strips_trailing_slash(self) -> None:
+        self.assertEqual(Config(VALID).rates_api().base_url, "https://rates.example.com/v1")
+
+    def test_rates_api_raises_on_missing_or_invalid_values(self) -> None:
+        cases = [
+            {**VALID, "RATES_API_KEY": ""},
+            {key: value for key, value in VALID.items() if key != "RATES_API_URL"},
+            {**VALID, "RATES_API_URL": "http://rates.example.com/v1"},
+            {**VALID, "RATES_API_TIMEOUT_SECONDS": "soon"},
+            {**VALID, "RATES_API_TIMEOUT_SECONDS": "0"},
+        ]
+        for values in cases:
+            with self.subTest(values=values), self.assertRaises(ConfigError):
+                Config(values).rates_api()
+
+    def test_load_raises_on_malformed_env_line(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_path = Path(directory) / ".env"
+            env_path.write_text("NOT_A_PAIR\n", encoding="utf-8")
+            with self.assertRaises(ConfigError):
+                Config.load(env_path, environ={})
+
+
+if __name__ == "__main__":
+    unittest.main()
