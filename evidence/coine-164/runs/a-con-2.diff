+import io
+import socket
+import unittest
+import urllib.error
+import urllib.request
+from typing import Any, List, Optional
+
+from app.config import RatesApiConfig
+from app.rates_client import RatesApiError, RatesClient
+
+CONFIG = RatesApiConfig(base_url="https://rates.example.com/v1", api_key="secret", timeout_seconds=5.0)
+
+
+class FakeOpener:
+    """Stands in for urlopen so no test touches the network."""
+
+    def __init__(self, body: bytes = b"", error: Optional[Exception] = None) -> None:
+        self.body = body
+        self.error = error
+        self.requests: List[urllib.request.Request] = []
+        self.timeouts: List[Any] = []
+
+    def __call__(self, request: urllib.request.Request, timeout: float) -> io.BytesIO:
+        self.requests.append(request)
+        self.timeouts.append(timeout)
+        if self.error is not None:
+            raise self.error
+        return io.BytesIO(self.body)
+
+
+class RatesClientTest(unittest.TestCase):
+    def test_get_latest_sends_expected_request_and_returns_payload(self) -> None:
+        opener = FakeOpener(b'{"base": "EUR", "rates": {"USD": 1.08}}')
+
+        payload = RatesClient(CONFIG, opener).get_latest("EUR", "USD")
+
+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+        request = opener.requests[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_method(), "GET")
+        self.assertEqual(request.get_header("X-api-key"), "secret")
+        self.assertEqual(opener.timeouts[0], 5.0)
+
+    def test_get_latest_raises_on_http_error(self) -> None:
+        error = urllib.error.HTTPError(CONFIG.base_url, 401, "Unauthorized", {}, None)
+        with self.assertRaisesRegex(RatesApiError, "HTTP 401"):
+            RatesClient(CONFIG, FakeOpener(error=error)).get_latest("EUR", "USD")
+
+    def test_get_latest_raises_when_unreachable(self) -> None:
+        for error in (urllib.error.URLError("no route"), socket.timeout("timed out")):
+            with self.subTest(error=error), self.assertRaisesRegex(RatesApiError, "unreachable"):
+                RatesClient(CONFIG, FakeOpener(error=error)).get_latest("EUR", "USD")
+
+    def test_get_latest_raises_on_invalid_json(self) -> None:
+        with self.assertRaisesRegex(RatesApiError, "invalid JSON"):
+            RatesClient(CONFIG, FakeOpener(b"<html>")).get_latest("EUR", "USD")
+
+    def test_get_latest_raises_on_non_object_json(self) -> None:
+        with self.assertRaisesRegex(RatesApiError, "non-object"):
+            RatesClient(CONFIG, FakeOpener(b"[1, 2]")).get_latest("EUR", "USD")
+
+
+if __name__ == "__main__":
+    unittest.main()
