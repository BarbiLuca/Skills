+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+
+
+class ConfigError(Exception):
+    """Raised when a required setting is missing or malformed."""
+
+
+@dataclass(frozen=True)
+class RatesApiConfig:
+    """Settings needed to reach the rates HTTP API."""
+
+    base_url: str
+    api_key: str
+    timeout_seconds: float
+
+
+class Config:
+    """Reads settings from a `.env` file, with real environment variables taking precedence."""
+
+    def __init__(self, values: Mapping[str, str]) -> None:
+        self._values = dict(values)
+
+    @classmethod
+    def load(cls, env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> "Config":
+        """
+        Build the configuration from a `.env` file and the process environment.
+
+        @param env_path Path of the optional `.env` file.
+        @param environ Environment mapping; defaults to `os.environ`.
+        @return The merged configuration.
+        @throws ConfigError If the `.env` file contains a malformed line.
+        """
+        values = cls._read_env_file(env_path)
+        values.update(os.environ if environ is None else environ)
+        return cls(values)
+
+    def rates_api(self) -> RatesApiConfig:
+        """
+        Return the rates API settings.
+
+        @return The validated API settings.
+        @throws ConfigError If a required setting is missing or invalid.
+        """
+        base_url = self._require("RATES_API_URL")
+        if not base_url.startswith("https://"):
+            raise ConfigError("RATES_API_URL must start with https://")
+        raw_timeout = self._require("RATES_API_TIMEOUT_SECONDS")
+        try:
+            timeout_seconds = float(raw_timeout)
+        except ValueError as error:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be a number") from error
+        if timeout_seconds <= 0:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be greater than zero")
+        return RatesApiConfig(
+            base_url=base_url.rstrip("/"),
+            api_key=self._require("RATES_API_KEY"),
+            timeout_seconds=timeout_seconds,
+        )
+
+    def _require(self, name: str) -> str:
+        value = self._values.get(name, "").strip()
+        if not value:
+            raise ConfigError(f"Missing required setting {name}")
+        return value
+
+    @staticmethod
+    def _read_env_file(path: Path) -> Dict[str, str]:
+        # Minimal parser so the project does not need python-dotenv for KEY=VALUE files.
+        values: Dict[str, str] = {}
+        if not path.is_file():
+            return values
+        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
+            stripped = line.strip()
+            if not stripped or stripped.startswith("#"):
+                continue
+            key, separator, value = stripped.partition("=")
+            if not separator or not key.strip():
+                raise ConfigError(f"Malformed line {number} in {path}")
+            values[key.strip()] = value.strip().strip("\"'")
+        return values
