+import logging
+import re
+from datetime import datetime, timezone
+from typing import Any, Callable, Dict
+
+from app.db import Database
+from app.rates_client import RatesClient
+
+CURRENCY_CODE = re.compile(r"^[A-Z]{3}$")
+
+logger = logging.getLogger(__name__)
+
+
+class InvalidCurrencyError(ValueError):
+    """Raised when a currency code is not a three-letter ISO 4217 code."""
+
+
+class InvalidRateResponseError(Exception):
+    """Raised when the API response does not contain a usable rate."""
+
+
+def _utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+class RatesService:
+    """Fetches a rate from the API, checks it, and stores it."""
+
+    def __init__(self, client: RatesClient, database: Database, clock: Callable[[], datetime] = _utc_now) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_rate(self, base: str, quote: str) -> float:
+        """
+        Download the current base/quote rate and save it in the `rates` table.
+
+        @param base Base currency code, e.g. "EUR" (case-insensitive).
+        @param quote Quote currency code, e.g. "USD" (case-insensitive).
+        @return The stored rate.
+        @throws InvalidCurrencyError If a currency code is malformed or both codes are equal.
+        @throws RatesApiError If the API call fails.
+        @throws InvalidRateResponseError If the response does not contain a valid rate.
+        """
+        base = self._normalize(base)
+        quote = self._normalize(quote)
+        if base == quote:
+            raise InvalidCurrencyError("Base and quote currencies must differ")
+
+        payload = self._client.get_latest(base, quote)
+        rate = self._extract_rate(payload, base, quote)
+        fetched_at = self._clock().isoformat()
+        self._database.save_rate(base, quote, rate, fetched_at)
+        logger.info(
+            "rate_fetched",
+            extra={"action": "fetch_rate", "base": base, "quote": quote, "rate": rate, "fetched_at": fetched_at},
+        )
+        return rate
+
+    @staticmethod
+    def _normalize(code: str) -> str:
+        normalized = code.strip().upper()
+        if not CURRENCY_CODE.match(normalized):
+            raise InvalidCurrencyError(f"Invalid currency code: {code!r}")
+        return normalized
+
+    @staticmethod
+    def _extract_rate(payload: Dict[str, Any], base: str, quote: str) -> float:
+        if payload.get("base") != base:
+            raise InvalidRateResponseError(f"Response base {payload.get('base')!r} does not match {base}")
+        rates = payload.get("rates")
+        if not isinstance(rates, dict) or quote not in rates:
+            raise InvalidRateResponseError(f"Response has no rate for {quote}")
+        rate = rates[quote]
+        # bool is a subclass of int, so it must be rejected explicitly.
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or rate <= 0:
+            raise InvalidRateResponseError(f"Response rate for {quote} is not a positive number")
+        return float(rate)
