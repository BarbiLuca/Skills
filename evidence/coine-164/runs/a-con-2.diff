@@ -0,0 +1,53 @@
+import json
+import socket
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Callable, Dict
+
+from app.config import RatesApiConfig
+
+Opener = Callable[..., Any]
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP client for the rates API; knows endpoints and transport only, no business rules."""
+
+    def __init__(self, config: RatesApiConfig, opener: Opener = urllib.request.urlopen) -> None:
+        self._config = config
+        # Injected so tests can replace the network call.
+        self._opener = opener
+
+    def get_latest(self, base: str, symbols: str) -> Dict[str, Any]:
+        """
+        Call `GET /latest` and return the decoded JSON body.
+
+        @param base Base currency code, e.g. "EUR".
+        @param symbols Quote currency code(s), e.g. "USD".
+        @return The decoded JSON object.
+        @throws RatesApiError If the request fails or the body is not a JSON object.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": symbols})
+        request = urllib.request.Request(
+            f"{self._config.base_url}/latest?{query}",
+            headers={"X-Api-Key": self._config.api_key, "Accept": "application/json"},
+            method="GET",
+        )
+        try:
+            with self._opener(request, timeout=self._config.timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"Rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, socket.timeout) as error:
+            raise RatesApiError("Rates API is unreachable") from error
+        try:
+            payload = json.loads(body)
+        except (json.JSONDecodeError, UnicodeDecodeError) as error:
+            raise RatesApiError("Rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("Rates API returned a non-object JSON body")
+        return payload
