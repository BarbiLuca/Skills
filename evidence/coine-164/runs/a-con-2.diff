+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict
+from unittest import mock
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+from app.rates_service import InvalidCurrencyError, InvalidRateResponseError, RatesService
+
+FIXED_NOW = datetime(2026, 10, 16, 12, 0, tzinfo=timezone.utc)
+
+
+class RatesServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        self.service = RatesService(self.client, self.database, clock=lambda: FIXED_NOW)
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def _respond(self, payload: Dict[str, Any]) -> None:
+        self.client.get_latest.return_value = payload
+
+    def test_fetch_rate_stores_rate_from_api(self) -> None:
+        self._respond({"base": "EUR", "rates": {"USD": 1.08}})
+
+        rate = self.service.fetch_rate("eur", "usd")
+
+        self.assertEqual(rate, 1.08)
+        self.client.get_latest.assert_called_once_with("EUR", "USD")
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": FIXED_NOW.isoformat()}],
+        )
+
+    def test_fetch_rate_rejects_invalid_currency_without_calling_api(self) -> None:
+        for base, quote in (("EURO", "USD"), ("EUR", "U$D"), ("", "USD"), ("EUR", "eur")):
+            with self.subTest(base=base, quote=quote), self.assertRaises(InvalidCurrencyError):
