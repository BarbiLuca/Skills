@@ -0,0 +1,39 @@
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+
+
+def _utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+class RatesService:
+    """Fetches current exchange rates from the API and stores them."""
+
+    def __init__(self, client: RatesClient, database: Database, clock: Callable[[], datetime] = _utc_now) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_and_store(self, base: str, quote: str) -> float:
+        """Fetch the current rate for a currency pair and save it in the rates table.
+
+        @param base: Base currency code, e.g. "EUR"; case-insensitive.
+        @param quote: Quote currency code, e.g. "USD"; case-insensitive.
+        @return: The stored rate.
+        @throws RatesApiError: If the API call fails or the response lacks a positive rate for the pair.
+        @throws sqlite3.Error: If the rate cannot be stored.
+        """
+        base = base.upper()
+        quote = quote.upper()
+        payload = self._client.get_latest(base, [quote])
+        rates = payload.get("rates") if isinstance(payload, dict) else None
+        if not isinstance(payload, dict) or payload.get("base") != base or not isinstance(rates, dict):
+            raise RatesApiError(f"Unexpected response for base {base}: {payload!r}")
+        rate = rates.get(quote)
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or rate <= 0:
+            raise RatesApiError(f"Response has no valid {base}/{quote} rate: {rate!r}")
+        self._database.insert_rate(base, quote, float(rate), self._clock().isoformat())
+        return float(rate)
