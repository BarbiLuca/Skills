+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+
+
+class ConfigError(Exception):
+    """Raised when a required configuration value is missing or invalid."""
+
+
+@dataclass(frozen=True)
+class Config:
+    """Application settings read from `.env` and the process environment."""
+
+    rates_api_url: str
+    rates_api_key: str
+    rates_api_timeout_seconds: float
+
+
+def read_env_file(path: Path) -> dict:
+    """Parse a `.env` file of `KEY=value` lines.
+
+    @param path: Location of the `.env` file; a missing file yields no values.
+    @return: Mapping of keys to values, with surrounding quotes stripped.
+    @throws OSError: If the file exists but cannot be read.
+    """
+    if not path.exists():
+        return {}
+    values = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        values[key.strip()] = value.strip().strip("\"'")
+    return values
+
+
+def load_config(env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> Config:
+    """Build the application config; process environment variables override `.env`.
+
+    @param env_path: Location of the `.env` file.
+    @param environ: Environment to read; defaults to `os.environ`.
+    @return: The loaded configuration.
+    @throws ConfigError: If a required value is missing or the timeout is not a number.
+    """
+    values = {**read_env_file(env_path), **(os.environ if environ is None else environ)}
+    missing = [key for key in ("RATES_API_URL", "RATES_API_KEY") if not values.get(key)]
+    if missing:
+        raise ConfigError(f"Missing configuration: {', '.join(missing)} (set them in .env)")
+    try:
+        timeout = float(values.get("RATES_API_TIMEOUT_SECONDS", "10"))
+    except ValueError as error:
+        raise ConfigError("RATES_API_TIMEOUT_SECONDS must be a number") from error
+    return Config(
+        rates_api_url=values["RATES_API_URL"],
+        rates_api_key=values["RATES_API_KEY"],
+        rates_api_timeout_seconds=timeout,
+    )
