+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import ConfigError, load_config
+
+
+class ConfigTest(unittest.TestCase):
+    def test_load_config_reads_env_file_with_environment_override(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_path = Path(directory) / ".env"
+            env_path.write_text(
+                "# comment\nRATES_API_URL=https://rates.example.com/v1\nRATES_API_KEY=\"from-file\"\n",
+                encoding="utf-8",
+            )
+
+            config = load_config(env_path, environ={"RATES_API_KEY": "from-env"})
+
+        self.assertEqual(config.rates_api_url, "https://rates.example.com/v1")
+        self.assertEqual(config.rates_api_key, "from-env")
+        self.assertEqual(config.rates_api_timeout_seconds, 10.0)
+
+    def test_load_config_raises_when_api_key_missing(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            with self.assertRaisesRegex(ConfigError, "RATES_API_KEY"):
+                load_config(Path(directory) / ".env", environ={"RATES_API_URL": "https://rates.example.com/v1"})
+
+
+if __name__ == "__main__":
+    unittest.main()
