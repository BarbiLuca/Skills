index 0000000..ba60b05
--- /dev/null
+++ b/app/rates_client.py
@@ -0,0 +1,42 @@
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+
+
+class RatesApiError(Exception):
+    """Raised when the rates HTTP API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP client for the rates API; one public method per endpoint, no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout_seconds: float) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout_seconds = timeout_seconds
+
+    def get_latest(self, base: str, symbols: list) -> dict:
+        """Call `GET /latest` for the current rates of a base currency.
+
+        @param base: Base currency code, e.g. "EUR".
+        @param symbols: Quote currency codes to request, e.g. ["USD"].
+        @return: The decoded JSON body, e.g. {"base": "EUR", "rates": {"USD": 1.08}}.
+        @throws RatesApiError: On network failure, a non-2xx status, or a body that is not JSON.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": ",".join(symbols)})
+        request = urllib.request.Request(
+            f"{self._base_url}/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"Rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, TimeoutError) as error:
+            raise RatesApiError(f"Rates API unreachable: {error}") from error
+        try:
+            return json.loads(body)
+        except ValueError as error:
+            raise RatesApiError("Rates API returned a body that is not JSON") from error
