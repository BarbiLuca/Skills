+++ b/tests/test_rates_client.py
@@ -0,0 +1,48 @@
+import io
+import unittest
+import urllib.error
+from unittest import mock
+
+from app.rates_client import RatesApiError, RatesClient
+
+
+class RatesClientTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.client = RatesClient("https://rates.example.com/v1/", "secret-key", 5.0)
+
+    @mock.patch("app.rates_client.urllib.request.urlopen")
+    def test_get_latest_sends_api_key_and_returns_json(self, urlopen: mock.MagicMock) -> None:
+        urlopen.return_value.__enter__.return_value = io.BytesIO(b'{"base": "EUR", "rates": {"USD": 1.08}}')
+
+        result = self.client.get_latest("EUR", ["USD"])
+
+        self.assertEqual(result, {"base": "EUR", "rates": {"USD": 1.08}})
+        request = urlopen.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret-key")
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5.0)
+
+    @mock.patch("app.rates_client.urllib.request.urlopen")
+    def test_get_latest_raises_on_http_error(self, urlopen: mock.MagicMock) -> None:
+        urlopen.side_effect = urllib.error.HTTPError("url", 401, "Unauthorized", {}, None)
+
+        with self.assertRaisesRegex(RatesApiError, "HTTP 401"):
+            self.client.get_latest("EUR", ["USD"])
+
+    @mock.patch("app.rates_client.urllib.request.urlopen")
+    def test_get_latest_raises_on_network_error(self, urlopen: mock.MagicMock) -> None:
+        urlopen.side_effect = urllib.error.URLError("no route")
+
+        with self.assertRaisesRegex(RatesApiError, "unreachable"):
+            self.client.get_latest("EUR", ["USD"])
+
+    @mock.patch("app.rates_client.urllib.request.urlopen")
+    def test_get_latest_raises_on_invalid_json(self, urlopen: mock.MagicMock) -> None:
+        urlopen.return_value.__enter__.return_value = io.BytesIO(b"<html>")
+
+        with self.assertRaisesRegex(RatesApiError, "not JSON"):
+            self.client.get_latest("EUR", ["USD"])
+
+
+if __name__ == "__main__":
+    unittest.main()
