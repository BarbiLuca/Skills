+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+DEFAULT_API_BASE_URL = "https://rates.example.com/v1"
+DEFAULT_API_TIMEOUT_SECONDS = 10.0
+
+
+class ConfigError(Exception):
+    """Raised when a required configuration value is missing or invalid."""
+
+
+@dataclass(frozen=True)
+class Config:
+    """Application settings loaded from the environment and the `.env` file."""
+
+    api_base_url: str
+    api_key: str
+    api_timeout_seconds: float
+
+
+def read_env_file(path: Path) -> Dict[str, str]:
+    """Parse a `.env` file made of `KEY=value` lines.
+
+    @param path: location of the `.env` file; a missing file yields no values.
+    @return: the variables defined in the file, with surrounding quotes removed.
+    @throws OSError: if the file exists but cannot be read.
+    """
+    if not path.exists():
+        return {}
+    values: Dict[str, str] = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        value = value.strip()
+        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+            value = value[1:-1]
+        values[key.strip()] = value
+    return values
+
+
+def load_config(env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> Config:
+    """Build the configuration; process environment variables override the `.env` file.
+
+    @param env_path: location of the `.env` file.
+    @param environ: environment variables to use instead of `os.environ` (for tests).
+    @return: the loaded configuration.
+    @throws ConfigError: if `RATES_API_KEY` is missing or the timeout is not a positive number.
+    """
+    values = read_env_file(env_path)
+    values.update(os.environ if environ is None else environ)
+
+    api_key = values.get("RATES_API_KEY", "").strip()
+    if not api_key:
+        raise ConfigError("RATES_API_KEY is not set; add it to .env (see .env.example)")
+
+    raw_timeout = values.get("RATES_API_TIMEOUT_SECONDS", str(DEFAULT_API_TIMEOUT_SECONDS))
+    try:
+        timeout = float(raw_timeout)
+    except ValueError:
+        raise ConfigError(f"RATES_API_TIMEOUT_SECONDS must be a number, got {raw_timeout!r}") from None
+    if timeout <= 0:
+        raise ConfigError(f"RATES_API_TIMEOUT_SECONDS must be positive, got {raw_timeout!r}")
+
+    return Config(
+        api_base_url=values.get("RATES_API_BASE_URL", DEFAULT_API_BASE_URL).rstrip("/"),
+        api_key=api_key,
+        api_timeout_seconds=timeout,
+    )
