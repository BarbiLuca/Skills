@@ -0,0 +1,60 @@
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+from app.rates_service import RatesService
+
+FIXED_NOW = datetime(2026, 10, 16, 12, 0, 0, tzinfo=timezone.utc)
+
+
+class RatesServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        self.service = RatesService(self.client, self.database, clock=lambda: FIXED_NOW)
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_fetch_rate_stores_rate_from_api(self) -> None:
+        self.client.latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+
+        rate = self.service.fetch_rate("eur", "usd")
+
+        self.assertEqual(rate, 1.08)
+        self.client.latest.assert_called_once_with("EUR", "USD")
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": "2026-10-16T12:00:00+00:00"}],
+        )
+
+    def test_fetch_rate_missing_quote_raises_and_stores_nothing(self) -> None:
+        self.client.latest.return_value = {"base": "EUR", "rates": {}}
+
+        with self.assertRaisesRegex(RatesApiError, "no rate for USD"):
+            self.service.fetch_rate("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+    def test_fetch_rate_non_positive_rate_raises_and_stores_nothing(self) -> None:
+        self.client.latest.return_value = {"base": "EUR", "rates": {"USD": 0}}
+
+        with self.assertRaisesRegex(RatesApiError, "invalid rate"):
+            self.service.fetch_rate("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+    def test_fetch_rate_wrong_base_raises_and_stores_nothing(self) -> None:
+        self.client.latest.return_value = {"base": "GBP", "rates": {"USD": 1.3}}
+
+        with self.assertRaisesRegex(RatesApiError, "expected 'EUR'"):
+            self.service.fetch_rate("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
