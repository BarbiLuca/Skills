@@ -0,0 +1,44 @@
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+
+
+def utc_now() -> datetime:
+    """Return the current time in UTC."""
+    return datetime.now(timezone.utc)
+
+
+class RatesService:
+    """Fetches current rates from the API and stores them in the database."""
+
+    def __init__(self, client: RatesClient, database: Database, clock: Callable[[], datetime] = utc_now) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_rate(self, base: str, quote: str) -> float:
+        """Download the current base/quote rate and store it in the `rates` table.
+
+        @param base: base currency code, e.g. "EUR" (case-insensitive).
+        @param quote: quote currency code, e.g. "USD" (case-insensitive).
+        @return: the stored rate.
+        @throws RatesApiError: if the API call fails or the response lacks a valid positive rate.
+        """
+        base = base.strip().upper()
+        quote = quote.strip().upper()
+        payload = self._client.latest(base, quote)
+
+        if payload.get("base") != base:
+            raise RatesApiError(f"rates API answered for base {payload.get('base')!r}, expected {base!r}")
+        rates = payload.get("rates")
+        if not isinstance(rates, dict) or quote not in rates:
+            raise RatesApiError(f"rates API response has no rate for {quote}")
+        rate = rates[quote]
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or rate <= 0:
+            raise RatesApiError(f"rates API returned an invalid rate for {quote}: {rate!r}")
+
+        fetched_at = self._clock().astimezone(timezone.utc).isoformat(timespec="seconds")
+        self._database.insert_rate(base, quote, float(rate), fetched_at)
+        return float(rate)
