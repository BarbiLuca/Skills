index 0000000..b97a509
--- /dev/null
+++ b/app/rates_client.py
@@ -0,0 +1,48 @@
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP client for the rates API; one public method per endpoint, no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout_seconds: float) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout_seconds = timeout_seconds
+
+    def latest(self, base: str, symbols: str) -> Dict[str, Any]:
+        """Call `GET /latest` and return the decoded JSON body.
+
+        @param base: base currency code, e.g. "EUR".
+        @param symbols: quote currency codes, comma-separated, e.g. "USD".
+        @return: the decoded response, e.g. {"base": "EUR", "rates": {"USD": 1.08}}.
+        @throws RatesApiError: on network errors, non-2xx status, or a body that is not a JSON object.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": symbols})
+        request = urllib.request.Request(
+            f"{self._base_url}/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+            method="GET",
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, OSError) as error:
+            raise RatesApiError(f"rates API request failed: {error}") from error
+
+        try:
+            payload = json.loads(body)
+        except ValueError as error:
+            raise RatesApiError("rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("rates API returned a JSON value that is not an object")
+        return payload
