@@ -0,0 +1,41 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import ConfigError, load_config
+
+
+class ConfigTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.env_path = Path(self._directory.name) / ".env"
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_load_config_reads_env_file_returns_values(self) -> None:
+        self.env_path.write_text(
+            "# comment\nRATES_API_BASE_URL=https://rates.test/v1/\nRATES_API_KEY=\"from-file\"\n",
+            encoding="utf-8",
+        )
+
+        config = load_config(self.env_path, environ={})
+
+        self.assertEqual(config.api_base_url, "https://rates.test/v1")
+        self.assertEqual(config.api_key, "from-file")
+        self.assertEqual(config.api_timeout_seconds, 10.0)
+
+    def test_load_config_environment_overrides_env_file(self) -> None:
+        self.env_path.write_text("RATES_API_KEY=from-file\n", encoding="utf-8")
+
+        config = load_config(self.env_path, environ={"RATES_API_KEY": "from-env"})
+
+        self.assertEqual(config.api_key, "from-env")
+
+    def test_load_config_missing_api_key_raises_config_error(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "RATES_API_KEY"):
+            load_config(self.env_path, environ={})
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_rates_client.py b/tests/test_rates_client.py
new file mode 100644
index 0000000..81dd955
--- /dev/null
+++ b/tests/test_rates_client.py
@@ -0,0 +1,50 @@
+import io
+import unittest
+import urllib.error
+from unittest import mock
+
+from app.rates_client import RatesApiError, RatesClient
+
+
+class FakeResponse(io.BytesIO):
+    def __enter__(self) -> "FakeResponse":
+        return self
+
+    def __exit__(self, *args: object) -> None:
+        self.close()
+
+
+class RatesClientTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.client = RatesClient("https://rates.example.com/v1/", "secret-key", 5.0)
+
+    def test_latest_sends_api_key_and_query_returns_payload(self) -> None:
+        body = b'{"base": "EUR", "rates": {"USD": 1.08}}'
+        with mock.patch("urllib.request.urlopen", return_value=FakeResponse(body)) as urlopen:
+            payload = self.client.latest("EUR", "USD")
+
+        request = urlopen.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret-key")
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5.0)
+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+
+    def test_latest_http_error_raises_rates_api_error(self) -> None:
+        error = urllib.error.HTTPError("url", 401, "Unauthorized", {}, None)
+        with mock.patch("urllib.request.urlopen", side_effect=error):
+            with self.assertRaisesRegex(RatesApiError, "HTTP 401"):
+                self.client.latest("EUR", "USD")
+
+    def test_latest_network_error_raises_rates_api_error(self) -> None:
+        with mock.patch("urllib.request.urlopen", side_effect=urllib.error.URLError("no route")):
+            with self.assertRaises(RatesApiError):
+                self.client.latest("EUR", "USD")
+
+    def test_latest_invalid_json_raises_rates_api_error(self) -> None:
+        with mock.patch("urllib.request.urlopen", return_value=FakeResponse(b"<html>")):
+            with self.assertRaisesRegex(RatesApiError, "invalid JSON"):
+                self.client.latest("EUR", "USD")
+
+
+if __name__ == "__main__":
+    unittest.main()
