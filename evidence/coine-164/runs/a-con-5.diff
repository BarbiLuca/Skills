@@ -0,0 +1,65 @@
+import json
+import logging
+import uuid
+from datetime import datetime, timezone
+
+# Attributes every LogRecord has; anything else came from `extra=` and is context worth emitting.
+_STANDARD_ATTRIBUTES = set(vars(logging.makeLogRecord({}))) | {"message", "asctime"}
+
+
+class JsonFormatter(logging.Formatter):
+    """Formats each record as one JSON line including `extra` context fields."""
+
+    def format(self, record: logging.LogRecord) -> str:
+        """Render a record as JSON.
+
+        @param record: the log record.
+        @return: a single-line JSON string.
+        """
+        entry = {
+            "timestamp": datetime.fromtimestamp(record.created, timezone.utc).isoformat(),
+            "level": record.levelname,
+            "logger": record.name,
+            "message": record.getMessage(),
+        }
+        entry.update({key: value for key, value in vars(record).items() if key not in _STANDARD_ATTRIBUTES})
+        if record.exc_info:
+            entry["stack_trace"] = self.formatException(record.exc_info)
+        return json.dumps(entry, default=str)
+
+
+class RequestContextFilter(logging.Filter):
+    """Adds the same request_id to every record of one CLI invocation."""
+
+    def __init__(self, request_id: str) -> None:
+        super().__init__()
+        self._request_id = request_id
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        """Attach the request id.
+
+        @param record: the log record.
+        @return: always True, so the record is kept.
+        """
+        record.request_id = self._request_id
+        return True
+
+
+class LoggingSetup:
+    """Configures structured logging to stderr for the CLI."""
+
+    @staticmethod
+    def configure(level: int = logging.INFO) -> str:
+        """Install the JSON handler on the root logger.
+
+        @param level: minimum level to emit.
+        @return: the request id assigned to this invocation.
+        """
+        request_id = uuid.uuid4().hex
+        handler = logging.StreamHandler()
+        handler.setFormatter(JsonFormatter())
+        handler.addFilter(RequestContextFilter(request_id))
+        root = logging.getLogger()
+        root.handlers = [handler]
+        root.setLevel(level)
+        return request_id
