+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesApiClient:
+    """HTTP client for the rates API; one public method per endpoint, no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout: float) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout = timeout
+
+    def get_latest(self, base: str, symbols: str) -> Dict[str, Any]:
+        """Call `GET /v1/latest`.
+
+        @param base: base currency code, e.g. "EUR".
+        @param symbols: comma-separated quote currency codes, e.g. "USD".
+        @return: the decoded JSON body.
+        @throws RatesApiError: on network errors, non-2xx status, or a body that is not a JSON object.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": symbols})
+        request = urllib.request.Request(
+            f"{self._base_url}/v1/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+            method="GET",
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, TimeoutError) as error:
+            raise RatesApiError(f"rates API unreachable: {error}") from error
+
+        try:
+            payload = json.loads(body)
+        except (json.JSONDecodeError, UnicodeDecodeError) as error:
+            raise RatesApiError("rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("rates API returned a JSON value that is not an object")
+        return payload
