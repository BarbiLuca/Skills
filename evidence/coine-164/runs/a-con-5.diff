+import logging
+import math
+import re
+from datetime import datetime, timezone
+
+from app.db import Database
+from app.rates_client import RatesApiClient, RatesApiError
+
+CURRENCY_CODE = re.compile(r"^[A-Z]{3}$")
+
+logger = logging.getLogger(__name__)
+
+
+class RateService:
+    """Fetches a rate from the rates API and stores it in the database."""
+
+    def __init__(self, client: RatesApiClient, database: Database) -> None:
+        self._client = client
+        self._database = database
+
+    def fetch_and_store(self, base: str, quote: str) -> float:
+        """Download the current base/quote rate and save it.
+
+        @param base: base currency code (ISO 4217, case-insensitive), e.g. "EUR".
+        @param quote: quote currency code (ISO 4217, case-insensitive), e.g. "USD".
+        @return: the stored rate.
+        @throws ValueError: if a currency code is not three letters.
+        @throws RatesApiError: if the API call fails or the response lacks a valid rate.
+        """
+        base = self._normalize_code(base, "base")
+        quote = self._normalize_code(quote, "quote")
+
+        payload = self._client.get_latest(base, quote)
+        rate = self._extract_rate(payload, base, quote)
+        fetched_at = datetime.now(timezone.utc).isoformat()
+        self._database.save_rate(base, quote, rate, fetched_at)
+        logger.info(
+            "rate stored",
+            extra={"action": "rate_stored", "base": base, "quote": quote, "rate": rate, "fetched_at": fetched_at},
+        )
+        return rate
+
+    @staticmethod
+    def _normalize_code(code: str, label: str) -> str:
+        normalized = code.strip().upper()
+        if not CURRENCY_CODE.match(normalized):
+            raise ValueError(f"{label} currency must be a three-letter code, got {code!r}")
+        return normalized
+
+    @staticmethod
+    def _extract_rate(payload: dict, base: str, quote: str) -> float:
+        # The API echoes the base; a mismatch means we would store a rate for the wrong pair.
+        if payload.get("base") != base:
+            raise RatesApiError(f"rates API answered for base {payload.get('base')!r}, expected {base!r}")
+        rates = payload.get("rates")
+        if not isinstance(rates, dict) or quote not in rates:
+            raise RatesApiError(f"rates API response has no rate for {quote}")
+        rate = rates[quote]
+        # bool is a subclass of int, so exclude it explicitly.
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or not math.isfinite(rate) or rate <= 0:
+            raise RatesApiError(f"rates API returned an invalid rate for {quote}: {rate!r}")
+        return float(rate)
