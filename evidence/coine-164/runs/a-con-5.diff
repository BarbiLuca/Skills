+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from app.db import Database
+from app.rate_service import RateService
+from app.rates_client import RatesApiClient, RatesApiError
+
+
+class RateServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesApiClient, instance=True)
+        self.service = RateService(self.client, self.database)
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_fetch_and_store_saves_rate(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+
+        rate = self.service.fetch_and_store("eur", "usd")
+
+        self.assertEqual(rate, 1.08)
+        self.client.get_latest.assert_called_once_with("EUR", "USD")
+        rows = self.database.list_rates("EUR")
+        self.assertEqual(len(rows), 1)
+        self.assertEqual((rows[0]["base"], rows[0]["quote"], rows[0]["rate"]), ("EUR", "USD", 1.08))
+
+    def test_fetch_and_store_rejects_invalid_code_without_calling_api(self) -> None:
+        with self.assertRaises(ValueError):
+            self.service.fetch_and_store("EURO", "USD")
+        self.client.get_latest.assert_not_called()
+
+    def test_fetch_and_store_raises_when_quote_missing(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {}}
+        with self.assertRaisesRegex(RatesApiError, "no rate for USD"):
+            self.service.fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+    def test_fetch_and_store_raises_when_base_mismatch(self) -> None:
+        self.client.get_latest.return_value = {"base": "GBP", "rates": {"USD": 1.27}}
+        with self.assertRaisesRegex(RatesApiError, "expected 'EUR'"):
+            self.service.fetch_and_store("EUR", "USD")
+
+    def test_fetch_and_store_raises_when_rate_invalid(self) -> None:
+        for bad in ("1.08", -1, 0, True, None, float("nan")):
+            with self.subTest(rate=bad):
+                self.client.get_latest.return_value = {"base": "EUR", "rates": {"USD": bad}}
+                with self.assertRaises(RatesApiError):
+                    self.service.fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
