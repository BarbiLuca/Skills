+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import Config, ConfigError
+
+
+class ConfigTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.env_path = Path(self._directory.name) / ".env"
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_load_reads_env_file(self) -> None:
+        self.env_path.write_text('# comment\nRATES_API_URL=https://rates.example.com\nRATES_API_KEY="abc"\n')
+
+        config = Config.load(self.env_path, environ={})
+
+        self.assertEqual(config, Config("https://rates.example.com", "abc", 10.0))
+
+    def test_load_prefers_environment_over_env_file(self) -> None:
+        self.env_path.write_text("RATES_API_URL=https://file\nRATES_API_KEY=file-key\n")
+
+        config = Config.load(self.env_path, environ={"RATES_API_KEY": "env-key", "RATES_API_TIMEOUT": "3"})
+
+        self.assertEqual((config.rates_api_url, config.rates_api_key, config.rates_api_timeout), ("https://file", "env-key", 3.0))
+
+    def test_load_raises_when_key_missing(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "RATES_API_KEY"):
+            Config.load(self.env_path, environ={"RATES_API_URL": "https://rates.example.com"})
+
+    def test_load_raises_when_timeout_invalid(self) -> None:
+        environ = {"RATES_API_URL": "https://x", "RATES_API_KEY": "k", "RATES_API_TIMEOUT": "soon"}
+        with self.assertRaises(ConfigError):
+            Config.load(self.env_path, environ=environ)
+
+
+if __name__ == "__main__":
+    unittest.main()
