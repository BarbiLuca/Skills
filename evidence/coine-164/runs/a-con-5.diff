+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+DEFAULT_TIMEOUT_SECONDS = 10.0
+
+
+class ConfigError(Exception):
+    """Raised when a required configuration value is missing or invalid."""
+
+
+@dataclass(frozen=True)
+class Config:
+    """Application settings read from the environment and an optional `.env` file."""
+
+    rates_api_url: str
+    rates_api_key: str
+    rates_api_timeout: float
+
+    @classmethod
+    def load(cls, env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> "Config":
+        """Build the configuration; real environment variables override `.env` values.
+
+        @param env_path: path of the `.env` file; ignored if it does not exist.
+        @param environ: environment to read; defaults to `os.environ`.
+        @return: the validated configuration.
+        @throws ConfigError: if a required value is missing or the timeout is not a positive number.
+        """
+        values = cls._read_env_file(env_path)
+        values.update(os.environ if environ is None else environ)
+
+        url = cls._require(values, "RATES_API_URL")
+        key = cls._require(values, "RATES_API_KEY")
+        raw_timeout = values.get("RATES_API_TIMEOUT", str(DEFAULT_TIMEOUT_SECONDS))
+        try:
+            timeout = float(raw_timeout)
+        except ValueError as error:
+            raise ConfigError(f"RATES_API_TIMEOUT must be a number, got {raw_timeout!r}") from error
+        if timeout <= 0:
+            raise ConfigError("RATES_API_TIMEOUT must be greater than zero")
+        return cls(rates_api_url=url, rates_api_key=key, rates_api_timeout=timeout)
+
+    @staticmethod
+    def _require(values: Mapping[str, str], name: str) -> str:
+        value = values.get(name, "").strip()
+        if not value:
+            raise ConfigError(f"{name} is not set; add it to .env or the environment")
+        return value
+
+    @staticmethod
+    def _read_env_file(env_path: Path) -> Dict[str, str]:
+        # Minimal KEY=VALUE parser so the project does not need python-dotenv.
+        values: Dict[str, str] = {}
+        if not env_path.is_file():
+            return values
+        for line in env_path.read_text(encoding="utf-8").splitlines():
+            line = line.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            name, value = line.split("=", 1)
+            values[name.strip()] = value.strip().strip("\"'")
+        return values
