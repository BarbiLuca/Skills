+++ b/app/rates_client.py
@@ -0,0 +1,46 @@
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any
+
+
+class RatesClientError(Exception):
+    """Raised when the rates API cannot be reached or returns an invalid response."""
+
+
+class RatesClient:
+    """HTTP client for the exchange rates API. Transport only, no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout: float) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout = timeout
+
+    def get_latest(self, base: str, symbols: list[str]) -> dict[str, Any]:
+        """Call GET /latest and return the decoded JSON body.
+
+        @param base Base currency code, e.g. "EUR".
+        @param symbols Quote currency codes, e.g. ["USD"].
+        @return The decoded response, e.g. {"base": "EUR", "rates": {"USD": 1.08}}.
+        @throws RatesClientError On network errors, non-2xx status, or a non-JSON body.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": ",".join(symbols)}, safe=",")
+        request = urllib.request.Request(
+            f"{self._base_url}/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesClientError(f"Rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, TimeoutError) as error:
+            raise RatesClientError(f"Rates API unreachable: {error}") from error
+        try:
+            payload = json.loads(body)
+        except json.JSONDecodeError as error:
+            raise RatesClientError("Rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesClientError("Rates API returned an unexpected JSON shape")
+        return payload
