@@ -0,0 +1,46 @@
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesClient
+
+
+class RatesServiceError(Exception):
+    """Raised when a rate cannot be obtained from the API response."""
+
+
+def _utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+class RatesService:
+    """Fetches exchange rates from the API and stores them locally."""
+
+    def __init__(
+        self,
+        client: RatesClient,
+        database: Database,
+        clock: Callable[[], datetime] = _utc_now,
+    ) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_rate(self, base: str, quote: str) -> float:
+        """Download the current base/quote rate and store it in the rates table.
+
+        @param base Base currency code, case-insensitive.
+        @param quote Quote currency code, case-insensitive.
+        @return The stored rate.
+        @throws RatesClientError If the API call fails.
+        @throws RatesServiceError If the response does not contain a valid rate.
+        """
+        base = base.upper()
+        quote = quote.upper()
+        payload = self._client.get_latest(base, [quote])
+        rates = payload.get("rates")
+        rate = rates.get(quote) if isinstance(rates, dict) else None
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)):
+            raise RatesServiceError(f"Rates API response has no numeric rate for {base}/{quote}")
+        self._database.insert_rate(base, quote, float(rate), self._clock().isoformat())
+        return float(rate)
