@@ -0,0 +1,100 @@
+import io
+import json
+import tempfile
+import unittest
+import urllib.error
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+from app.config import Config, ConfigError, load_config
+from app.db import Database
+from app.rates_client import RatesClient, RatesClientError
+from app.rates_service import RatesService, RatesServiceError
+
+
+def _fake_response(payload: dict) -> mock.MagicMock:
+    response = mock.MagicMock()
+    response.read.return_value = json.dumps(payload).encode("utf-8")
+    response.__enter__.return_value = response
+    return response
+
+
+class RatesClientTest(unittest.TestCase):
+    def test_get_latest_sends_api_key_and_query(self) -> None:
+        client = RatesClient("https://rates.example.com/v1", "secret", 5.0)
+        with mock.patch("urllib.request.urlopen") as urlopen:
+            urlopen.return_value = _fake_response({"base": "EUR", "rates": {"USD": 1.08}})
+            payload = client.get_latest("EUR", ["USD"])
+
+        request = urlopen.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret")
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5.0)
+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+
+    def test_get_latest_raises_client_error_on_http_error(self) -> None:
+        client = RatesClient("https://rates.example.com/v1", "wrong", 5.0)
+        error = urllib.error.HTTPError("url", 401, "Unauthorized", {}, io.BytesIO(b""))
+        with mock.patch("urllib.request.urlopen", side_effect=error):
+            with self.assertRaises(RatesClientError):
+                client.get_latest("EUR", ["USD"])
+
+
+class RatesServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        self.now = datetime(2026, 10, 16, 12, 0, tzinfo=timezone.utc)
+        self.service = RatesService(self.client, self.database, clock=lambda: self.now)
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_fetch_rate_stores_rate_in_database(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+
+        rate = self.service.fetch_rate("eur", "usd")
+
+        self.assertEqual(rate, 1.08)
+        self.client.get_latest.assert_called_once_with("EUR", ["USD"])
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": "2026-10-16T12:00:00+00:00"}],
+        )
+
+    def test_fetch_rate_raises_when_quote_missing(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {}}
+
+        with self.assertRaises(RatesServiceError):
+            self.service.fetch_rate("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+class ConfigTest(unittest.TestCase):
+    def test_load_config_reads_env_file(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_file = Path(directory) / ".env"
+            env_file.write_text(
+                "# comment\nRATES_API_URL=https://rates.example.com/v1\nRATES_API_KEY=\"secret\"\n",
+                encoding="utf-8",
+            )
+            with mock.patch.dict("os.environ", {}, clear=True):
+                config = load_config(env_file)
+
+        self.assertEqual(
+            config,
+            Config(rates_api_url="https://rates.example.com/v1", rates_api_key="secret", rates_api_timeout=10.0),
+        )
+
+    def test_load_config_raises_when_key_missing(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            with mock.patch.dict("os.environ", {}, clear=True):
+                with self.assertRaises(ConfigError):
+                    load_config(Path(directory) / ".env")
+
+
+if __name__ == "__main__":
+    unittest.main()
