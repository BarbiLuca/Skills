+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Callable, Dict
+
+Opener = Callable[..., Any]
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP client for the rates API: transport and JSON decoding only, no business rules."""
+
+    def __init__(
+        self,
+        base_url: str,
+        api_key: str,
+        timeout_seconds: float,
+        opener: Opener = urllib.request.urlopen,
+    ) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout_seconds = timeout_seconds
+        # Injected so tests can replace the network call.
+        self._opener = opener
+
+    def get_latest(self, base: str, symbols: str) -> Dict[str, Any]:
+        """
+        Call GET /v1/latest.
+
+        @param base str base currency code, e.g. "EUR"
+        @param symbols str quote currency code(s), comma separated, e.g. "USD"
+        @return Dict[str, Any] decoded JSON body
+        @throws RatesApiError on network failure, non-2xx status or a body that is not a JSON object
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": symbols})
+        request = urllib.request.Request(
+            f"{self._base_url}/v1/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+            method="GET",
+        )
+        try:
+            with self._opener(request, timeout=self._timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"Rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, TimeoutError, OSError) as error:
+            raise RatesApiError(f"Rates API unreachable: {error}") from error
+
+        try:
+            payload = json.loads(body)
+        except (json.JSONDecodeError, UnicodeDecodeError) as error:
+            raise RatesApiError("Rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("Rates API returned JSON that is not an object")
+        return payload
