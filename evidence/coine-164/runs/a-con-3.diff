+import logging
+import math
+import re
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesClient
+
+CURRENCY_CODE = re.compile(r"^[A-Z]{3}$")
+
+logger = logging.getLogger(__name__)
+
+
+class InvalidCurrencyError(ValueError):
+    """Raised when a currency code is not three ASCII letters."""
+
+
+class InvalidRateResponseError(Exception):
+    """Raised when the API answer does not contain a usable rate for the requested pair."""
+
+
+class RateService:
+    """Fetches the current rate for a currency pair and stores it."""
+
+    def __init__(
+        self,
+        client: RatesClient,
+        database: Database,
+        clock: Callable[[], datetime] = lambda: datetime.now(timezone.utc),
+    ) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_and_store(self, base: str, quote: str) -> float:
+        """
+        Download the current base/quote rate and save it in the rates table.
+
+        @param base str base currency code (case-insensitive), e.g. "EUR"
+        @param quote str quote currency code (case-insensitive), e.g. "USD"
+        @return float the stored rate
+        @throws InvalidCurrencyError when a code is malformed or base equals quote
+        @throws InvalidRateResponseError when the response lacks a positive numeric rate for the pair
+        @throws RatesApiError when the API call fails
+        """
+        base = self._normalize(base)
+        quote = self._normalize(quote)
+        if base == quote:
+            raise InvalidCurrencyError("Base and quote currency must differ")
+
+        payload = self._client.get_latest(base, quote)
+        rate = self._extract_rate(payload, base, quote)
+        fetched_at = self._clock().isoformat()
+        self._database.save_rate(base, quote, rate, fetched_at)
+        logger.info(
+            "rate stored",
+            extra={"action": "rate_fetched", "base": base, "quote": quote, "rate": rate, "fetched_at": fetched_at},
+        )
+        return rate
+
+    @staticmethod
+    def _normalize(code: str) -> str:
+        normalized = code.strip().upper()
+        if not CURRENCY_CODE.match(normalized):
+            raise InvalidCurrencyError(f"Invalid currency code: {code!r} (expected 3 letters, e.g. EUR)")
+        return normalized
+
+    @staticmethod
+    def _extract_rate(payload: dict, base: str, quote: str) -> float:
+        if payload.get("base") != base:
+            raise InvalidRateResponseError(f"Response base {payload.get('base')!r} does not match {base}")
+        rates = payload.get("rates")
+        if not isinstance(rates, dict) or quote not in rates:
+            raise InvalidRateResponseError(f"Response has no rate for {quote}")
+        rate = rates[quote]
+        # bool is a subclass of int, so exclude it explicitly.
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)):
+            raise InvalidRateResponseError(f"Rate for {quote} is not a number")
+        if not math.isfinite(rate) or rate <= 0:
+            raise InvalidRateResponseError(f"Rate for {quote} must be a positive number")
+        return float(rate)
