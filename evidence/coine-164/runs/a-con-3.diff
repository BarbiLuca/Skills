+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+DEFAULT_TIMEOUT_SECONDS = 10.0
+
+
+class ConfigError(Exception):
+    """Raised when a required configuration value is missing or invalid."""
+
+
+class EnvFile:
+    """Minimal KEY=VALUE reader, so the project does not need python-dotenv."""
+
+    def __init__(self, path: Path = DEFAULT_ENV_PATH) -> None:
+        self._path = path
+
+    def read(self) -> Dict[str, str]:
+        """
+        Parse the file into a dictionary; a missing file yields an empty one.
+
+        @return Dict[str, str] variables defined in the file
+        @throws OSError when the file exists but cannot be read
+        """
+        if not self._path.is_file():
+            return {}
+        values: Dict[str, str] = {}
+        for line in self._path.read_text(encoding="utf-8").splitlines():
+            line = line.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            values[key.strip()] = value.strip().strip("'\"")
+        return values
+
+
+@dataclass(frozen=True)
+class Config:
+    """Application settings, read from the process environment with `.env` as fallback."""
+
+    rates_api_base_url: str
+    rates_api_key: str
+    rates_api_timeout_seconds: float = DEFAULT_TIMEOUT_SECONDS
+
+    @classmethod
+    def load(cls, env_file: Optional[EnvFile] = None, environ: Optional[Mapping[str, str]] = None) -> "Config":
+        """
+        Build the configuration; real environment variables override `.env`.
+
+        @param env_file EnvFile source of fallback values (defaults to ./.env)
+        @param environ Mapping[str, str] process environment (defaults to os.environ)
+        @return Config validated settings
+        @throws ConfigError when a required value is missing or malformed
+        """
+        values = dict((env_file or EnvFile()).read())
+        values.update(environ if environ is not None else os.environ)
+
+        base_url = cls._require(values, "RATES_API_BASE_URL").rstrip("/")
+        if not base_url.startswith("https://"):
+            # The API key travels in a header, so plain HTTP would leak it.
+            raise ConfigError("RATES_API_BASE_URL must use https://")
+        api_key = cls._require(values, "RATES_API_KEY")
+
+        raw_timeout = values.get("RATES_API_TIMEOUT_SECONDS", "").strip()
+        try:
+            timeout = float(raw_timeout) if raw_timeout else DEFAULT_TIMEOUT_SECONDS
+        except ValueError as error:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be a number") from error
+        if timeout <= 0:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be positive")
+
+        return cls(rates_api_base_url=base_url, rates_api_key=api_key, rates_api_timeout_seconds=timeout)
+
+    @staticmethod
+    def _require(values: Mapping[str, str], key: str) -> str:
+        value = values.get(key, "").strip()
+        if not value:
+            raise ConfigError(f"Missing required setting {key} (set it in .env or the environment)")
+        return value
