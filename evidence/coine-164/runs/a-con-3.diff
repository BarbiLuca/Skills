+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import Config, ConfigError, EnvFile
+
+
+class ConfigTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.env_path = Path(self._directory.name) / ".env"
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def _load(self, file_content: str = "", environ: dict = None) -> Config:
+        self.env_path.write_text(file_content, encoding="utf-8")
+        return Config.load(EnvFile(self.env_path), environ or {})
+
+    def test_load_reads_env_file(self) -> None:
+        config = self._load("# comment\nRATES_API_BASE_URL=https://rates.test/\nRATES_API_KEY='abc'\n")
+        self.assertEqual(config.rates_api_base_url, "https://rates.test")
+        self.assertEqual(config.rates_api_key, "abc")
+        self.assertEqual(config.rates_api_timeout_seconds, 10.0)
+
+    def test_load_environment_overrides_env_file(self) -> None:
+        config = self._load(
+            "RATES_API_BASE_URL=https://rates.test\nRATES_API_KEY=from-file\n",
+            {"RATES_API_KEY": "from-env", "RATES_API_TIMEOUT_SECONDS": "3"},
+        )
+        self.assertEqual(config.rates_api_key, "from-env")
+        self.assertEqual(config.rates_api_timeout_seconds, 3.0)
+
+    def test_load_raises_on_missing_key(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "RATES_API_KEY"):
+            self._load("RATES_API_BASE_URL=https://rates.test\n")
+
+    def test_load_raises_on_plain_http(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "https"):
+            self._load("RATES_API_BASE_URL=http://rates.test\nRATES_API_KEY=abc\n")
+
+    def test_load_raises_on_bad_timeout(self) -> None:
+        for value in ["abc", "0", "-1"]:
+            with self.subTest(value=value):
+                with self.assertRaises(ConfigError):
+                    self._load(f"RATES_API_BASE_URL=https://rates.test\nRATES_API_KEY=abc\nRATES_API_TIMEOUT_SECONDS={value}\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
