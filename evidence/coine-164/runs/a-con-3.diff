+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+        request = opener.requests[0]
+        self.assertEqual(request.full_url, "https://rates.test/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_method(), "GET")
+        self.assertEqual(request.get_header("X-api-key"), "secret-key")
+        self.assertEqual(opener.timeouts, [5.0])
+
+    def test_get_latest_raises_on_http_error(self) -> None:
