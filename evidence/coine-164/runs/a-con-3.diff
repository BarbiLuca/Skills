+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+from app.rates_service import InvalidCurrencyError, InvalidRateResponseError, RateService
+
+FIXED_TIME = datetime(2026, 10, 16, 12, 0, tzinfo=timezone.utc)
+
+
+class RateServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        self.service = RateService(self.client, self.database, clock=lambda: FIXED_TIME)
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_fetch_and_store_saves_rate(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+
+        rate = self.service.fetch_and_store("eur", "usd")
+
+        self.assertEqual(rate, 1.08)
+        self.client.get_latest.assert_called_once_with("EUR", "USD")
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": FIXED_TIME.isoformat()}],
+        )
+
+    def test_fetch_and_store_rejects_invalid_code_without_calling_api(self) -> None:
+        for base, quote in [("EU", "USD"), ("EUR", "US1"), ("EUR", "EUR"), ("EUR'; --", "USD")]:
+            with self.subTest(base=base, quote=quote):
+                with self.assertRaises(InvalidCurrencyError):
+                    self.service.fetch_and_store(base, quote)
+        self.client.get_latest.assert_not_called()
+
+    def test_fetch_and_store_rejects_bad_payload_and_stores_nothing(self) -> None:
+        bad_payloads = [
+            {"base": "GBP", "rates": {"USD": 1.08}},
+            {"base": "EUR"},
+            {"base": "EUR", "rates": {"JPY": 160}},
+            {"base": "EUR", "rates": {"USD": "1.08"}},
+            {"base": "EUR", "rates": {"USD": True}},
+            {"base": "EUR", "rates": {"USD": 0}},
+            {"base": "EUR", "rates": {"USD": float("inf")}},
+        ]
+        for payload in bad_payloads:
+            with self.subTest(payload=payload):
+                self.client.get_latest.return_value = payload
+                with self.assertRaises(InvalidRateResponseError):
+                    self.service.fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+    def test_fetch_and_store_propagates_api_error(self) -> None:
+        self.client.get_latest.side_effect = RatesApiError("down")
+        with self.assertRaises(RatesApiError):
+            self.service.fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
