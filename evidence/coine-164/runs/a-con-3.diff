+import io
+import json
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+from app import __main__ as cli
+from app.config import Config, ConfigError
+from app.db import Database
+from app.rates_client import RatesClient
+
+CONFIG = Config(rates_api_base_url="https://rates.test", rates_api_key="secret-key")
+
+
+class FetchCommandTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def _run(self, base: str, quote: str, opener: mock.Mock) -> tuple:
+        stdout, stderr = io.StringIO(), io.StringIO()
+        # Bind the fake opener so the real urlopen is never reached.
+        client_factory = lambda url, key, timeout: RatesClient(url, key, timeout, opener=opener)
+        with mock.patch.object(cli.Config, "load", return_value=CONFIG), mock.patch.object(
+            cli, "RatesClient", side_effect=client_factory
+        ), redirect_stdout(stdout), redirect_stderr(stderr), self.assertLogs(level="INFO"):
+            code = cli.fetch(self.database, base, quote)
+        return code, stdout.getvalue(), stderr.getvalue()
+
+    def test_fetch_stores_rate_and_prints_it(self) -> None:
+        opener = mock.Mock(return_value=io.BytesIO(json.dumps({"base": "EUR", "rates": {"USD": 1.08}}).encode()))
+
+        code, stdout, _ = self._run("eur", "usd", opener)
+
+        self.assertEqual(code, 0)
+        self.assertEqual(stdout, "EUR/USD 1.08\n")
+        self.assertEqual(self.database.list_rates("EUR")[0]["rate"], 1.08)
+        request = opener.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.test/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret-key")
+
+    def test_fetch_hides_api_error_details_from_user(self) -> None:
+        opener = mock.Mock(side_effect=OSError("internal detail"))
+
+        code, _, stderr = self._run("EUR", "USD", opener)
+
+        self.assertEqual(code, 1)
+        self.assertNotIn("internal detail", stderr)
+        self.assertIn("could not fetch the rate", stderr)
+
+    def test_fetch_reports_missing_config_with_exit_code_2(self) -> None:
+        stderr = io.StringIO()
+        with mock.patch.object(cli.Config, "load", side_effect=ConfigError("Missing required setting RATES_API_KEY")), redirect_stderr(stderr):
+            code = cli.fetch(self.database, "EUR", "USD")
+
+        self.assertEqual(code, 2)
+        self.assertIn("RATES_API_KEY", stderr.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
