new file mode 100644
index 0000000..ea28e19
--- /dev/null
+++ b/app/rates_client.py
@@ -0,0 +1,47 @@
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict, List
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP client for the rates API; one method per endpoint, no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout_seconds: float) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout_seconds = timeout_seconds
+
+    def get_latest(self, base: str, symbols: List[str]) -> Dict[str, Any]:
+        """Call `GET /latest` for the current rates of a base currency.
+
+        @param base: base currency code, e.g. "EUR".
+        @param symbols: quote currency codes to request, e.g. ["USD"].
+        @return: the decoded JSON body, e.g. {"base": "EUR", "rates": {"USD": 1.08}}.
+        @throws RatesApiError: on network errors, non-2xx responses, or a body that is not a JSON object.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": ",".join(symbols)})
+        request = urllib.request.Request(
+            f"{self._base_url}/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+            method="GET",
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self._timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"Rates API returned HTTP {error.code}") from error
+        except (urllib.error.URLError, TimeoutError, OSError) as error:
+            raise RatesApiError(f"Rates API is unreachable: {error}") from error
+        try:
+            payload = json.loads(body)
+        except ValueError as error:
+            raise RatesApiError("Rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("Rates API returned a JSON value that is not an object")
+        return payload
