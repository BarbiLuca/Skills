@@ -0,0 +1,66 @@
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+DEFAULT_RATES_API_URL = "https://rates.example.com/v1"
+DEFAULT_RATES_API_TIMEOUT_SECONDS = 10.0
+
+
+class ConfigError(Exception):
+    """Raised when a required configuration value is missing or invalid."""
+
+
+@dataclass(frozen=True)
+class Config:
+    """Application settings read from `.env` and the process environment."""
+
+    rates_api_url: str
+    rates_api_key: str
+    rates_api_timeout_seconds: float
+
+
+def read_env_file(path: Path) -> Dict[str, str]:
+    """Parse a `.env` file of `KEY=VALUE` lines.
+
+    Blank lines and lines starting with `#` are ignored; surrounding quotes are stripped.
+
+    @param path: location of the `.env` file.
+    @return: the variables defined in the file, or an empty dict if the file does not exist.
+    @throws OSError: if the file exists but cannot be read.
+    """
+    if not path.is_file():
+        return {}
+    values: Dict[str, str] = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        values[key.strip()] = value.strip().strip("\"'")
+    return values
+
+
+def load_config(env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> Config:
+    """Build the application config; process environment variables override `.env` values.
+
+    @param env_path: location of the `.env` file.
+    @param environ: environment to read; defaults to `os.environ`.
+    @return: the resolved configuration.
+    @throws ConfigError: if `RATES_API_KEY` is missing or `RATES_API_TIMEOUT_SECONDS` is not a number.
+    """
+    values = {**read_env_file(env_path), **(os.environ if environ is None else environ)}
+    api_key = values.get("RATES_API_KEY", "")
+    if not api_key:
+        raise ConfigError("RATES_API_KEY is not set; add it to .env (see .env.example)")
+    timeout = values.get("RATES_API_TIMEOUT_SECONDS", str(DEFAULT_RATES_API_TIMEOUT_SECONDS))
+    try:
+        timeout_seconds = float(timeout)
+    except ValueError as error:
+        raise ConfigError(f"RATES_API_TIMEOUT_SECONDS must be a number, got {timeout!r}") from error
+    return Config(
+        rates_api_url=values.get("RATES_API_URL", DEFAULT_RATES_API_URL).rstrip("/"),
+        rates_api_key=api_key,
+        rates_api_timeout_seconds=timeout_seconds,
+    )
