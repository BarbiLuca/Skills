@@ -0,0 +1,38 @@
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+
+
+def utc_now() -> datetime:
+    """Return the current time in UTC."""
+    return datetime.now(timezone.utc)
+
+
+class RatesService:
+    """Fetches exchange rates from the API and stores them in the database."""
+
+    def __init__(self, client: RatesClient, database: Database, clock: Callable[[], datetime] = utc_now) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_and_store(self, base: str, quote: str) -> float:
+        """Download the current base/quote rate and save it to the `rates` table.
+
+        @param base: base currency code, case-insensitive, e.g. "EUR".
+        @param quote: quote currency code, case-insensitive, e.g. "USD".
+        @return: the stored rate.
+        @throws RatesApiError: if the API call fails or the response has no positive numeric rate for the quote.
+        """
+        base = base.upper()
+        quote = quote.upper()
+        payload = self._client.get_latest(base, [quote])
+        rates = payload.get("rates")
+        rate = rates.get(quote) if isinstance(rates, dict) else None
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or rate <= 0:
+            raise RatesApiError(f"Rates API response has no valid {base}/{quote} rate")
+        fetched_at = self._clock().isoformat(timespec="seconds")
+        self._database.save_rate(base, quote, float(rate), fetched_at)
+        return float(rate)
