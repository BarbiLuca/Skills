+++ b/tests/test_fetch.py
@@ -0,0 +1,85 @@
+import io
+import json
+import tempfile
+import unittest
+import urllib.error
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+from app.config import ConfigError, load_config
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+from app.rates_service import RatesService
+
+
+def fake_response(payload: object) -> mock.MagicMock:
+    response = mock.MagicMock()
+    response.__enter__.return_value.read.return_value = json.dumps(payload).encode()
+    return response
+
+
+class RatesClientTest(unittest.TestCase):
+    def test_get_latest_sends_api_key_and_query(self) -> None:
+        client = RatesClient("https://rates.example.com/v1", "secret", 5.0)
+        with mock.patch("urllib.request.urlopen", return_value=fake_response({"base": "EUR", "rates": {"USD": 1.08}})) as urlopen:
+            payload = client.get_latest("EUR", ["USD"])
+        request = urlopen.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret")
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5.0)
+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+
+    def test_get_latest_raises_on_http_error(self) -> None:
+        client = RatesClient("https://rates.example.com/v1", "wrong", 5.0)
+        error = urllib.error.HTTPError("https://rates.example.com/v1/latest", 401, "Unauthorized", {}, io.BytesIO())
+        with mock.patch("urllib.request.urlopen", side_effect=error):
+            with self.assertRaisesRegex(RatesApiError, "HTTP 401"):
+                client.get_latest("EUR", ["USD"])
+
+
+class RatesServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        clock = lambda: datetime(2026, 10, 16, 12, 0, 0, tzinfo=timezone.utc)
+        self.service = RatesService(self.client, self.database, clock)
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_fetch_and_store_saves_rate(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+        rate = self.service.fetch_and_store("eur", "usd")
+        self.assertEqual(rate, 1.08)
+        self.client.get_latest.assert_called_once_with("EUR", ["USD"])
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": "2026-10-16T12:00:00+00:00"}],
+        )
+
+    def test_fetch_and_store_raises_when_quote_missing(self) -> None:
+        self.client.get_latest.return_value = {"base": "EUR", "rates": {}}
+        with self.assertRaises(RatesApiError):
+            self.service.fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+class ConfigTest(unittest.TestCase):
+    def test_load_config_reads_env_file(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_path = Path(directory) / ".env"
+            env_path.write_text("# comment\nRATES_API_KEY=\"secret\"\nRATES_API_URL=https://example.test/v1/\n")
+            config = load_config(env_path, environ={})
+        self.assertEqual(config.rates_api_key, "secret")
+        self.assertEqual(config.rates_api_url, "https://example.test/v1")
+
+    def test_load_config_raises_without_api_key(self) -> None:
+        with self.assertRaises(ConfigError):
+            load_config(Path("/nonexistent/.env"), environ={})
+
+
+if __name__ == "__main__":
+    unittest.main()
