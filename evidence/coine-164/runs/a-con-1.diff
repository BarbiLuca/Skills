@@ -0,0 +1,65 @@
+import io
+import socket
+import unittest
+import urllib.error
+import urllib.request
+from typing import Any, List, Optional
+
+from app.rates_client import RatesApiClient, RatesApiError
+
+
+class FakeOpener:
+    """Stands in for urllib.request.urlopen so no real request is sent."""
+
+    def __init__(self, body: bytes = b"", error: Optional[Exception] = None) -> None:
+        self.body = body
+        self.error = error
+        self.requests: List[urllib.request.Request] = []
+        self.timeouts: List[float] = []
+
+    def __call__(self, request: urllib.request.Request, timeout: float) -> Any:
+        self.requests.append(request)
+        self.timeouts.append(timeout)
+        if self.error is not None:
+            raise self.error
+        return io.BytesIO(self.body)
+
+
+class RatesApiClientTest(unittest.TestCase):
+    def make_client(self, opener: FakeOpener) -> RatesApiClient:
+        return RatesApiClient("https://rates.example.com/v1/", "secret", 5.0, opener=opener)
+
+    def test_latest_sends_expected_request(self) -> None:
+        opener = FakeOpener(b'{"base": "EUR", "rates": {"USD": 1.08}}')
+        payload = self.make_client(opener).latest("EUR", ["USD"])
+        request = opener.requests[0]
+        self.assertEqual(request.full_url, "https://rates.example.com/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret")
+        self.assertEqual(request.get_method(), "GET")
+        self.assertEqual(opener.timeouts, [5.0])
+        self.assertEqual(payload, {"base": "EUR", "rates": {"USD": 1.08}})
+
+    def test_latest_raises_on_http_error(self) -> None:
+        error = urllib.error.HTTPError("url", 401, "Unauthorized", {}, None)
