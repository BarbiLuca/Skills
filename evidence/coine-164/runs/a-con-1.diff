@@ -0,0 +1,76 @@
+import getpass
+import json
+import logging
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+DEFAULT_LOG_PATH = Path("rates.log")
+CONTEXT_FIELDS = ("action", "base", "quote", "rate")
+
+
+class ContextFilter(logging.Filter):
+    """Stamps every record with the run's request_id and the OS user."""
+
+    def __init__(self, request_id: str, user_id: str) -> None:
+        super().__init__()
+        self._request_id = request_id
+        self._user_id = user_id
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        """Attach context fields.
+
+        @param record: The record being emitted.
+        @return: Always True (the filter only enriches).
+        @throws None.
+        """
+        record.request_id = self._request_id
+        record.user_id = self._user_id
+        return True
+
+
+class JsonFormatter(logging.Formatter):
+    """One JSON object per line so logs stay machine-searchable."""
+
+    def format(self, record: logging.LogRecord) -> str:
+        """Render a record as JSON.
+
+        @param record: The record to render.
+        @return: A single-line JSON string.
+        @throws None.
+        """
+        entry = {
+            "timestamp": datetime.fromtimestamp(record.created, timezone.utc).isoformat(),
+            "level": record.levelname,
+            "logger": record.name,
+            "message": record.getMessage(),
+            "request_id": getattr(record, "request_id", None),
+            "user_id": getattr(record, "user_id", None),
+        }
+        for field in CONTEXT_FIELDS:
+            if hasattr(record, field):
+                entry[field] = getattr(record, field)
+        if record.exc_info:
+            entry["stack_trace"] = self.formatException(record.exc_info)
+        return json.dumps(entry)
+
+
+class LoggingSetup:
+    """Configures the root logger for one CLI invocation."""
+
+    @staticmethod
+    def configure(log_path: Path = DEFAULT_LOG_PATH) -> str:
+        """Send structured logs to a file, keeping stack traces out of the terminal.
+
+        @param log_path: File that receives the JSON log lines.
+        @return: The request_id assigned to this run.
+        @throws OSError: When the log file cannot be opened.
+        """
+        request_id = uuid.uuid4().hex
+        handler = logging.FileHandler(log_path, encoding="utf-8")
+        handler.setFormatter(JsonFormatter())
+        handler.addFilter(ContextFilter(request_id, getpass.getuser()))
+        root = logging.getLogger()
+        root.handlers = [handler]
+        root.setLevel(logging.INFO)
+        return request_id
