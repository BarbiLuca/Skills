+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, List, Sequence
+
+from app.db import Database
+from app.rates_client import RatesApiError
+from app.rates_service import RatesService
+
+
+class FakeClient:
+    def __init__(self, payload: Dict[str, Any]) -> None:
+        self.payload = payload
+        self.calls: List[tuple] = []
+
+    def latest(self, base: str, symbols: Sequence[str]) -> Dict[str, Any]:
+        self.calls.append((base, list(symbols)))
+        return self.payload
+
+
+FIXED_NOW = datetime(2026, 10, 16, 12, 0, 0, tzinfo=timezone.utc)
+
+
+class RatesServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def make_service(self, payload: Dict[str, Any]) -> RatesService:
+        self.client = FakeClient(payload)
+        return RatesService(self.client, self.database, clock=lambda: FIXED_NOW)
+
+    def test_fetch_and_store_saves_rate(self) -> None:
+        service = self.make_service({"base": "EUR", "rates": {"USD": 1.08}})
+        fetched = service.fetch_and_store("eur", "usd")
+        self.assertEqual(self.client.calls, [("EUR", ["USD"])])
+        self.assertEqual(fetched.rate, 1.08)
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": "2026-10-16T12:00:00+00:00"}],
+        )
+
+    def test_fetch_and_store_rejects_invalid_currency_code(self) -> None:
+        service = self.make_service({})
+        for code in ("EU", "EURO", "E1R", "'; DROP TABLE rates;--"):
+            with self.subTest(code=code), self.assertRaises(ValueError):
+                service.fetch_and_store(code, "USD")
+        self.assertEqual(self.client.calls, [])
+
+    def test_fetch_and_store_rejects_bad_responses_without_saving(self) -> None:
+        bad_payloads = [
+            {"base": "GBP", "rates": {"USD": 1.08}},
+            {"base": "EUR", "rates": {}},
+            {"base": "EUR", "rates": "nope"},
+            {"base": "EUR", "rates": {"USD": "1.08"}},
+            {"base": "EUR", "rates": {"USD": True}},
+            {"base": "EUR", "rates": {"USD": 0}},
+            {"base": "EUR", "rates": {"USD": -1.0}},
+        ]
+        for payload in bad_payloads:
+            with self.subTest(payload=payload), self.assertRaises(RatesApiError):
+                self.make_service(payload).fetch_and_store("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
