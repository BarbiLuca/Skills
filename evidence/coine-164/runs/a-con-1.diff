+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from unittest import mock
+
+from app.__main__ import run_fetch
+from app.config import ConfigError, Settings
+from app.rates_client import RatesApiError
+from app.rates_service import FetchedRate
+
+SETTINGS = Settings("https://rates.example.com/v1", "secret", 5.0)
+
+
+class RunFetchTest(unittest.TestCase):
+    def run_with(self, service_result: object) -> tuple:
+        stdout, stderr = io.StringIO(), io.StringIO()
+        with mock.patch("app.__main__.Settings.load", return_value=SETTINGS), mock.patch(
+            "app.__main__.RatesService"
+        ) as service_class, mock.patch("app.__main__.logger") as self.logger, redirect_stdout(
+            stdout
+        ), redirect_stderr(stderr):
+            method = service_class.return_value.fetch_and_store
+            if isinstance(service_result, Exception):
+                method.side_effect = service_result
+            else:
+                method.return_value = service_result
+            code = run_fetch("EUR", "USD", mock.Mock(), "req-1")
+        return code, stdout.getvalue(), stderr.getvalue()
+
+    def test_run_fetch_prints_stored_rate(self) -> None:
+        code, out, _ = self.run_with(FetchedRate("EUR", "USD", 1.08, "2026-10-16T12:00:00+00:00"))
+        self.assertEqual(code, 0)
+        self.assertEqual(out, "EUR/USD 1.08 (2026-10-16T12:00:00+00:00)\n")
+
+    def test_run_fetch_hides_api_error_details(self) -> None:
+        code, _, err = self.run_with(RatesApiError("rates API returned HTTP 500"))
+        self.assertEqual(code, 1)
+        self.assertNotIn("HTTP 500", err)
+        self.assertIn("req-1", err)
+        self.assertTrue(self.logger.error.call_args.kwargs["exc_info"])
+
+    def test_run_fetch_reports_invalid_input(self) -> None:
+        code, _, err = self.run_with(ValueError("invalid currency code: 'EURO'"))
+        self.assertEqual(code, 2)
+        self.assertIn("EURO", err)
+
+    def test_run_fetch_reports_missing_config(self) -> None:
+        stderr = io.StringIO()
+        with mock.patch("app.__main__.Settings.load", side_effect=ConfigError("RATES_API_KEY is not set")), mock.patch(
+            "app.__main__.logger"
+        ), redirect_stderr(stderr):
+            code = run_fetch("EUR", "USD", mock.Mock(), "req-1")
+        self.assertEqual(code, 2)
+        self.assertIn("RATES_API_KEY", stderr.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
