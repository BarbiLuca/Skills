+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import ConfigError, Settings
+
+
+class SettingsTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.env_path = Path(self._directory.name) / ".env"
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_load_reads_env_file(self) -> None:
+        self.env_path.write_text(
+            "# comment\nRATES_API_BASE_URL=https://rates.example.com/v1/\nRATES_API_KEY='abc'\n"
+        )
+        settings = Settings.load(self.env_path, environ={})
+        self.assertEqual(settings.api_base_url, "https://rates.example.com/v1")
+        self.assertEqual(settings.api_key, "abc")
+        self.assertEqual(settings.api_timeout_seconds, 10.0)
+
+    def test_load_environment_overrides_env_file(self) -> None:
+        self.env_path.write_text("RATES_API_BASE_URL=https://a.example.com\nRATES_API_KEY=file\n")
+        settings = Settings.load(self.env_path, environ={"RATES_API_KEY": "env"})
+        self.assertEqual(settings.api_key, "env")
+
+    def test_load_raises_when_key_missing(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "RATES_API_KEY"):
+            Settings.load(self.env_path, environ={"RATES_API_BASE_URL": "https://a.example.com"})
+
+    def test_load_raises_on_plain_http(self) -> None:
+        with self.assertRaisesRegex(ConfigError, "https"):
+            Settings.load(self.env_path, environ={"RATES_API_BASE_URL": "http://a.example.com", "RATES_API_KEY": "k"})
+
+    def test_load_raises_on_bad_timeout(self) -> None:
+        environ = {"RATES_API_BASE_URL": "https://a.example.com", "RATES_API_KEY": "k"}
+        for timeout in ("abc", "0", "-1"):
+            with self.subTest(timeout=timeout), self.assertRaises(ConfigError):
+                Settings.load(self.env_path, environ={**environ, "RATES_API_TIMEOUT_SECONDS": timeout})
+
+
+if __name__ == "__main__":
+    unittest.main()
