@@ -0,0 +1,60 @@
+import json
+import socket
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Callable, Dict, Sequence
+
+Opener = Callable[..., Any]
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesApiClient:
+    """HTTP access to the rates API; no business rules live here."""
+
+    def __init__(
+        self,
+        base_url: str,
+        api_key: str,
+        timeout_seconds: float,
+        opener: Opener = urllib.request.urlopen,
+    ) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._api_key = api_key
+        self._timeout_seconds = timeout_seconds
+        # Injectable so tests never open a real connection.
+        self._opener = opener
+
+    def latest(self, base: str, symbols: Sequence[str]) -> Dict[str, Any]:
+        """Call GET /latest.
+
+        @param base: Base currency code, e.g. "EUR".
+        @param symbols: Quote currency codes, e.g. ["USD"].
+        @return: The decoded JSON object.
+        @throws RatesApiError: On network failure, non-2xx status, or a non-object JSON body.
+        """
+        query = urllib.parse.urlencode({"base": base, "symbols": ",".join(symbols)})
+        request = urllib.request.Request(
+            f"{self._base_url}/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+            method="GET",
+        )
+        try:
+            with self._opener(request, timeout=self._timeout_seconds) as response:
+                body = response.read()
+        except urllib.error.HTTPError as error:
+            raise RatesApiError(f"rates API returned HTTP {error.code}") from error
+        except urllib.error.URLError as error:
+            raise RatesApiError(f"rates API unreachable: {error.reason}") from error
+        except socket.timeout as error:
+            raise RatesApiError("rates API timed out") from error
+        try:
+            payload = json.loads(body)
+        except (json.JSONDecodeError, UnicodeDecodeError) as error:
+            raise RatesApiError("rates API returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RatesApiError("rates API returned a non-object JSON body")
+        return payload
