@@ -0,0 +1,76 @@
+import logging
+import re
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesApiClient, RatesApiError
+
+CURRENCY_CODE = re.compile(r"^[A-Z]{3}$")
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class FetchedRate:
+    base: str
+    quote: str
+    rate: float
+    fetched_at: str
+
+
+class RatesService:
+    """Fetches a rate from the API, validates it, and stores it."""
+
+    def __init__(
+        self,
+        client: RatesApiClient,
+        database: Database,
+        clock: Callable[[], datetime] = lambda: datetime.now(timezone.utc),
+    ) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch_and_store(self, base: str, quote: str) -> FetchedRate:
+        """Download the current base/quote rate and save it in the rates table.
+
+        @param base: Base currency code (case-insensitive), e.g. "EUR".
+        @param quote: Quote currency code (case-insensitive), e.g. "USD".
+        @return: The stored rate.
+        @throws ValueError: When a currency code is not three letters.
+        @throws RatesApiError: When the API fails or its response lacks a valid rate.
+        """
+        base = self._normalize(base)
+        quote = self._normalize(quote)
+        payload = self._client.latest(base, [quote])
+        rate = self._extract_rate(payload, base, quote)
+        fetched = FetchedRate(base, quote, rate, self._clock().isoformat(timespec="seconds"))
+        self._database.save_rate(fetched.base, fetched.quote, fetched.rate, fetched.fetched_at)
+        logger.info(
+            "rate stored",
+            extra={"action": "rate.stored", "base": base, "quote": quote, "rate": rate},
+        )
+        return fetched
+
+    @staticmethod
+    def _normalize(code: str) -> str:
+        normalized = code.strip().upper()
+        if not CURRENCY_CODE.match(normalized):
+            raise ValueError(f"invalid currency code: {code!r} (expected 3 letters, e.g. EUR)")
+        return normalized
+
+    @staticmethod
+    def _extract_rate(payload: dict, base: str, quote: str) -> float:
+        # The API is external input: check shape and values before they reach the database.
+        if payload.get("base") != base:
+            raise RatesApiError(f"rates API answered for base {payload.get('base')!r}, expected {base!r}")
+        rates = payload.get("rates")
+        if not isinstance(rates, dict) or quote not in rates:
+            raise RatesApiError(f"rates API response has no rate for {quote}")
+        rate = rates[quote]
+        # bool is a subclass of int, so exclude it explicitly.
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or rate <= 0:
+            raise RatesApiError(f"rates API returned an invalid rate for {quote}: {rate!r}")
+        return float(rate)
