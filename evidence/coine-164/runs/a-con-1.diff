+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+DEFAULT_TIMEOUT_SECONDS = 10.0
+
+
+class ConfigError(Exception):
+    """Raised when a required setting is missing or malformed."""
+
+
+class EnvFileReader:
+    """Parses a minimal KEY=VALUE .env file (stdlib only, to avoid adding python-dotenv)."""
+
+    def read(self, path: Path) -> Dict[str, str]:
+        """Read key/value pairs from a .env file.
+
+        @param path: Location of the .env file.
+        @return: The parsed values; empty when the file does not exist.
+        @throws ConfigError: When a non-comment line has no '='.
+        """
+        if not path.is_file():
+            return {}
+        values: Dict[str, str] = {}
+        for number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
+            line = raw_line.strip()
+            if not line or line.startswith("#"):
+                continue
+            if "=" not in line:
+                raise ConfigError(f"{path}:{number}: expected KEY=VALUE")
+            key, value = line.split("=", 1)
+            values[key.strip()] = value.strip().strip("'\"")
+        return values
+
+
+@dataclass(frozen=True)
+class Settings:
+    """Application settings sourced from the environment and the .env file."""
+
+    api_base_url: str
+    api_key: str
+    api_timeout_seconds: float
+
+    @classmethod
+    def load(
+        cls,
+        env_path: Path = DEFAULT_ENV_PATH,
+        environ: Optional[Mapping[str, str]] = None,
+    ) -> "Settings":
+        """Build settings; real environment variables override the .env file.
+
+        @param env_path: Location of the .env file.
+        @param environ: Environment mapping; defaults to os.environ.
+        @return: The validated settings.
+        @throws ConfigError: When a required value is missing or invalid.
+        """
+        values = {**EnvFileReader().read(env_path), **(os.environ if environ is None else environ)}
+        base_url = cls._required(values, "RATES_API_BASE_URL").rstrip("/")
+        if not base_url.startswith("https://"):
+            # The API key travels in a header, so plain HTTP would leak it.
+            raise ConfigError("RATES_API_BASE_URL must use https://")
+        raw_timeout = values.get("RATES_API_TIMEOUT_SECONDS", str(DEFAULT_TIMEOUT_SECONDS))
+        try:
+            timeout = float(raw_timeout)
+        except ValueError as error:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be a number") from error
+        if timeout <= 0:
+            raise ConfigError("RATES_API_TIMEOUT_SECONDS must be positive")
+        return cls(
+            api_base_url=base_url,
+            api_key=cls._required(values, "RATES_API_KEY"),
+            api_timeout_seconds=timeout,
+        )
+
+    @staticmethod
+    def _required(values: Mapping[str, str], key: str) -> str:
+        value = values.get(key, "").strip()
+        if not value:
+            raise ConfigError(f"{key} is not set (add it to .env or the environment)")
+        return value
