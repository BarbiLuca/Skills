new file mode 100644
index 0000000..71d7009
--- /dev/null
+++ b/app/rates_client.py
@@ -0,0 +1,42 @@
+import json
+from typing import Any, Dict
+from urllib.error import URLError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+
+class RatesApiError(Exception):
+    """Raised when the rates API cannot be reached or returns an unusable response."""
+
+
+class RatesClient:
+    """HTTP client for the rates API; one public method per endpoint, no business logic."""
+
+    def __init__(self, base_url: str, api_key: str, timeout: float) -> None:
+        self._base_url = base_url
+        self._api_key = api_key
+        self._timeout = timeout
+
+    def latest(self, base: str, symbols: str) -> Dict[str, Any]:
+        """Call GET /latest and return the decoded JSON body.
+
+        @param base: base currency code, e.g. "EUR".
+        @param symbols: comma-separated quote currency codes, e.g. "USD".
+        @return: the decoded response, e.g. {"base": "EUR", "rates": {"USD": 1.08}}.
+        @throws RatesApiError: on network errors, HTTP errors, or a body that is not a JSON object.
+        """
+        query = urlencode({"base": base, "symbols": symbols})
+        request = Request(
+            f"{self._base_url}/latest?{query}",
+            headers={"X-Api-Key": self._api_key, "Accept": "application/json"},
+        )
+        try:
+            with urlopen(request, timeout=self._timeout) as response:
+                body = json.loads(response.read().decode("utf-8"))
+        except URLError as error:
+            raise RatesApiError(f"Rates API request failed: {error}") from error
+        except (ValueError, UnicodeDecodeError) as error:
+            raise RatesApiError("Rates API returned invalid JSON") from error
+        if not isinstance(body, dict):
+            raise RatesApiError("Rates API returned an unexpected response")
+        return body
