@@ -0,0 +1,66 @@
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Mapping, Optional
+
+DEFAULT_ENV_PATH = Path(".env")
+
+
+class ConfigError(Exception):
+    """Raised when a required configuration value is missing or invalid."""
+
+
+@dataclass(frozen=True)
+class Config:
+    """Application settings read from the environment and the .env file."""
+
+    rates_api_url: str
+    rates_api_key: str
+    rates_api_timeout: float
+
+
+def read_env_file(path: Path) -> Dict[str, str]:
+    """Parse KEY=VALUE lines from a .env file.
+
+    @param path: location of the .env file.
+    @return: the parsed variables; empty when the file does not exist.
+    @throws OSError: when the file exists but cannot be read.
+    """
+    if not path.exists():
+        return {}
+    values: Dict[str, str] = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        values[key.strip()] = value.strip().strip("'\"")
+    return values
+
+
+def load_config(env_path: Path = DEFAULT_ENV_PATH, environ: Optional[Mapping[str, str]] = None) -> Config:
+    """Build the configuration; process environment variables override the .env file.
+
+    @param env_path: location of the .env file.
+    @param environ: environment variables to use instead of os.environ.
+    @return: the loaded configuration.
+    @throws ConfigError: when a required value is missing or the timeout is not a number.
+    """
+    values = {**read_env_file(env_path), **(os.environ if environ is None else environ)}
+
+    def require(name: str) -> str:
+        value = values.get(name, "")
+        if not value:
+            raise ConfigError(f"Missing required setting {name} (set it in .env)")
+        return value
+
+    try:
+        timeout = float(require("RATES_API_TIMEOUT"))
+    except ValueError as error:
+        raise ConfigError("RATES_API_TIMEOUT must be a number of seconds") from error
+
+    return Config(
+        rates_api_url=require("RATES_API_URL").rstrip("/"),
+        rates_api_key=require("RATES_API_KEY"),
+        rates_api_timeout=timeout,
+    )
