@@ -0,0 +1,35 @@
+from datetime import datetime, timezone
+from typing import Callable
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+
+
+def _utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+class RatesService:
+    """Fetches current exchange rates from the API and stores them in the database."""
+
+    def __init__(self, client: RatesClient, database: Database, clock: Callable[[], str] = _utc_now) -> None:
+        self._client = client
+        self._database = database
+        self._clock = clock
+
+    def fetch(self, base: str, quote: str) -> float:
+        """Download the current base/quote rate and store it in the rates table.
+
+        @param base: base currency code, e.g. "EUR"; case-insensitive.
+        @param quote: quote currency code, e.g. "USD"; case-insensitive.
+        @return: the stored rate.
+        @throws RatesApiError: when the API fails or the response lacks a valid rate for the pair.
+        """
+        base, quote = base.upper(), quote.upper()
+        body = self._client.latest(base, quote)
+        rates = body.get("rates")
+        rate = rates.get(quote) if isinstance(rates, dict) else None
+        if isinstance(rate, bool) or not isinstance(rate, (int, float)) or rate <= 0:
+            raise RatesApiError(f"Rates API response has no valid rate for {base}/{quote}")
+        self._database.insert_rate(base, quote, float(rate), self._clock())
+        return float(rate)
