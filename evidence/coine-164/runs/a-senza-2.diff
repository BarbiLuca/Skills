@@ -0,0 +1,27 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from app.config import ConfigError, load_config
+
+
+class ConfigTest(unittest.TestCase):
+    def test_load_config_reads_env_file_and_environment_overrides(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            env_path = Path(directory) / ".env"
+            env_path.write_text("RATES_API_URL=https://rates.test/v1/\nRATES_API_KEY=from-file\nRATES_API_TIMEOUT=10\n")
+
+            config = load_config(env_path, environ={"RATES_API_KEY": "from-env"})
+
+        self.assertEqual(config.rates_api_url, "https://rates.test/v1")
+        self.assertEqual(config.rates_api_key, "from-env")
+        self.assertEqual(config.rates_api_timeout, 10.0)
+
+    def test_load_config_raises_error_when_api_key_missing(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            with self.assertRaises(ConfigError):
+                load_config(Path(directory) / ".env", environ={"RATES_API_URL": "https://rates.test/v1", "RATES_API_TIMEOUT": "10"})
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_rates_client.py b/tests/test_rates_client.py
new file mode 100644
index 0000000..caef54b
--- /dev/null
+++ b/tests/test_rates_client.py
@@ -0,0 +1,38 @@
+import io
+import unittest
+from unittest import mock
+from urllib.error import URLError
+
+from app.rates_client import RatesApiError, RatesClient
+
+
+class RatesClientTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.client = RatesClient("https://rates.test/v1", "secret-key", 5.0)
+
+    @mock.patch("app.rates_client.urlopen")
+    def test_latest_sends_query_and_api_key_header(self, urlopen: mock.MagicMock) -> None:
+        urlopen.return_value.__enter__.return_value = io.BytesIO(b'{"base": "EUR", "rates": {"USD": 1.08}}')
+
+        body = self.client.latest("EUR", "USD")
+
+        self.assertEqual(body, {"base": "EUR", "rates": {"USD": 1.08}})
+        request = urlopen.call_args.args[0]
+        self.assertEqual(request.full_url, "https://rates.test/v1/latest?base=EUR&symbols=USD")
+        self.assertEqual(request.get_header("X-api-key"), "secret-key")
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5.0)
+
+    @mock.patch("app.rates_client.urlopen", side_effect=URLError("unreachable"))
+    def test_latest_raises_rates_api_error_on_network_failure(self, _urlopen: mock.MagicMock) -> None:
+        with self.assertRaises(RatesApiError):
+            self.client.latest("EUR", "USD")
+
+    @mock.patch("app.rates_client.urlopen")
+    def test_latest_raises_rates_api_error_on_invalid_json(self, urlopen: mock.MagicMock) -> None:
+        urlopen.return_value.__enter__.return_value = io.BytesIO(b"<html>")
+        with self.assertRaises(RatesApiError):
+            self.client.latest("EUR", "USD")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_rates_service.py b/tests/test_rates_service.py
new file mode 100644
index 0000000..94cceb8
--- /dev/null
+++ b/tests/test_rates_service.py
@@ -0,0 +1,43 @@
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from app.db import Database
+from app.rates_client import RatesApiError, RatesClient
+from app.rates_service import RatesService
+
+
+class RatesServiceTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.database = Database(Path(self._directory.name) / "test.db")
+        self.database.init_schema()
+        self.client = mock.create_autospec(RatesClient, instance=True)
+        self.service = RatesService(self.client, self.database, clock=lambda: "2026-10-16T12:00:00+00:00")
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_fetch_stores_rate_in_database(self) -> None:
+        self.client.latest.return_value = {"base": "EUR", "rates": {"USD": 1.08}}
+
+        rate = self.service.fetch("eur", "usd")
+
+        self.assertEqual(rate, 1.08)
+        self.client.latest.assert_called_once_with("EUR", "USD")
+        self.assertEqual(
+            self.database.list_rates("EUR"),
+            [{"base": "EUR", "quote": "USD", "rate": 1.08, "fetched_at": "2026-10-16T12:00:00+00:00"}],
+        )
+
+    def test_fetch_raises_error_and_stores_nothing_when_rate_missing(self) -> None:
+        self.client.latest.return_value = {"base": "EUR", "rates": {}}
+
+        with self.assertRaises(RatesApiError):
+            self.service.fetch("EUR", "USD")
+        self.assertEqual(self.database.list_rates("EUR"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
